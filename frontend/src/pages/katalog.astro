---
export const prerender = false;
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const API_URL = (import.meta as any).env?.PUBLIC_API_URL || '';

const FALLBACK_PROPERTIES = [
  {
    id: 'demo-kos-soekarno-hatta',
    title: 'Kos Eksklusif Griya Suhat Malang',
    category: 'kos',
    location: 'Jl. Soekarno Hatta, Lowokwaru, Kota Malang',
    block_or_unit: 'Kamar A-04',
    price: 1350000,
    price_unit: 'bulan',
    status: 'AVAILABLE',
    image_url: 'https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?auto=format&fit=crop&w=900&q=80',
    specifications: {
      kos_type: 'Kos Putra/Putri',
      bathroom: 'Kamar Mandi Dalam + Water Heater'
    }
  },
  {
    id: 'demo-rumah-sawojajar',
    title: 'Rumah Minimalis 2 Lantai Sawojajar',
    category: 'rumah',
    location: 'Sawojajar, Kedungkandang, Kota Malang',
    block_or_unit: 'Kavling B-12',
    price: 850000000,
    price_unit: 'unit',
    status: 'AVAILABLE',
    image_url: 'https://images.unsplash.com/photo-1568605114967-8130f3a36994?auto=format&fit=crop&w=900&q=80',
    specifications: {
      land_area: '120 m²',
      bedrooms: '3 Kamar Tidur',
      legality: 'SHM • IMB Lengkap'
    }
  },
  {
    id: 'demo-tanah-dau',
    title: 'Kavling Tanah Strategis Jalur Wisata Dau',
    category: 'tanah',
    location: 'Dau, Kabupaten Malang',
    block_or_unit: 'Kavling C-07',
    price: 375000000,
    price_unit: 'kavling',
    status: 'AVAILABLE',
    image_url: 'https://images.unsplash.com/photo-1500382017468-9049fed747ef?auto=format&fit=crop&w=900&q=80',
    specifications: {
      land_area: '200 m²',
      certificate: 'SHM (Sertifikat Hak Milik)'
    }
  }
];

let properties: any[] = [];
try {
  const res = await fetch(`${API_URL}/api/properties`, { cache: 'no-store' });
  if (res.ok) {
    const data = await res.json();
    properties = Array.isArray(data) && data.length > 0 ? data : FALLBACK_PROPERTIES;
  } else {
    properties = FALLBACK_PROPERTIES;
  }
} catch {
  properties = FALLBACK_PROPERTIES;
}

function getQuickSpecs(item: any): string[] {
  const cat = (item.category || '').toLowerCase();
  const s = item.specifications && typeof item.specifications === 'object' ? item.specifications : {};
  const badges: string[] = [];

  if (item.block_or_unit && item.block_or_unit !== '-') badges.push(item.block_or_unit);

  if (cat === 'kos') {
    if (s.kos_type) badges.push(s.kos_type);
    if (s.bathroom) badges.push(String(s.bathroom).replace(' + Water Heater', ''));
  } else if (cat === 'rumah') {
    if (s.land_area) badges.push(`LT ${s.land_area}`);
    if (s.bedrooms) badges.push(s.bedrooms);
    if (s.legality) badges.push(String(s.legality).split('•')[0].trim());
  } else if (cat === 'tanah') {
    if (s.land_area) badges.push(`Luas ${s.land_area}`);
    if (s.certificate) badges.push(String(s.certificate).split('(')[0].trim());
  }

  return badges.slice(0, 3);
}
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Katalog Properti — InfoProperti</title>
    <meta name="description" content="Cari dan filter unit Kos, Rumah, atau Kavling Tanah terverifikasi sesuai kebutuhan lokasi dan anggaran Anda di InfoProperti." />
    <link rel="canonical" href="https://infoproperti.web.id/katalog" />
    <style is:global>
      @import '../styles/global.css';
    </style>
  </head>
  <body class="bg-slate-50 text-slate-900 font-sans min-h-screen flex flex-col justify-between">
    <div>
      <Navbar active="katalog" />

      <section class="bg-[#0F172A] text-white py-14 px-4 border-b border-slate-800">
        <div class="max-w-4xl mx-auto text-center">
          <span class="inline-block px-3.5 py-1 bg-emerald-500/10 border border-emerald-500/30 rounded-full text-xs font-semibold text-emerald-400 mb-3">
            Daftar Unit Terverifikasi
          </span>
          <h1 class="text-3xl md:text-4xl font-extrabold">Katalog Properti Lengkap</h1>
          <p class="text-slate-300 text-xs sm:text-sm mt-2.5 max-w-2xl mx-auto leading-relaxed">
            Cari dan filter unit Kos, Rumah, atau Kavling Tanah sesuai kebutuhan lokasi dan anggaran Anda. Tandai suka atau simpan untuk dilihat di Profil.
          </p>

          <div class="mt-6 max-w-xl mx-auto bg-white p-1.5 rounded-xl flex gap-2 shadow-lg">
            <input
              type="text"
              id="search-input"
              placeholder="Cari lokasi, nama unit, SHM, atau fasilitas..."
              class="w-full px-3.5 py-2 text-xs sm:text-sm text-slate-800 focus:outline-none"
            />
            <button type="button" id="search-btn" class="bg-[#059669] hover:bg-emerald-700 text-white text-xs font-bold px-5 py-2 rounded-lg cursor-pointer">
              Cari
            </button>
          </div>
        </div>
      </section>

      <main class="max-w-6xl mx-auto px-4 py-10">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
          <div class="flex flex-wrap items-center gap-2.5">
            <p class="text-xs text-slate-500">
              Menampilkan <span id="visible-count" class="font-bold text-slate-900">{properties.length}</span> unit properti.
            </p>
            <a
              id="saved-shortcut-link"
              href="/profil"
              class="hidden px-3 py-1 rounded-lg text-[11px] font-bold bg-slate-900 text-white hover:bg-slate-800 transition"
            >
              Favorit &amp; Tersimpan (<span id="nav-saved-total">0</span>)
            </a>
          </div>

          <div class="flex flex-wrap items-center gap-2">
            <button type="button" data-filter="all" class="filter-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-[#0F172A] text-white border border-slate-800 cursor-pointer">
              Semua (<span id="all-count">{properties.length}</span>)
            </button>
            <button type="button" data-filter="kos" class="filter-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-white text-slate-600 border border-slate-200 hover:bg-slate-100 cursor-pointer">
              Kos
            </button>
            <button type="button" data-filter="rumah" class="filter-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-white text-slate-600 border border-slate-200 hover:bg-slate-100 cursor-pointer">
              Rumah
            </button>
            <button type="button" data-filter="tanah" class="filter-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-white text-slate-600 border border-slate-200 hover:bg-slate-100 cursor-pointer">
              Tanah
            </button>
          </div>
        </div>

        <div id="catalog-container">
          {properties.length > 0 ? (
            <div>
              <div id="cards-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {properties.map((item: any) => {
                  const stLower = String(item.status || 'available').toLowerCase();
                  const isBooked = stLower === 'booked' || stLower === 'sold';
                  const quickSpecs = getQuickSpecs(item);
                  const searchMeta = `${item.title || ''} ${item.location || ''} ${item.block_or_unit || ''} ${JSON.stringify(item.specifications || {})}`.toLowerCase();
                  const extraGallery = Array.isArray(item.gallery)
                    ? item.gallery
                    : (Array.isArray(item.specifications?.gallery) ? item.specifications.gallery : []);
                  const totalPhotos = (item.image_url ? 1 : 0) + extraGallery.filter(Boolean).length;

                  return (
                    <article
                      data-category={(item.category || '').toLowerCase()}
                      data-search={searchMeta}
                      class="property-card bg-white rounded-xl shadow-xs hover:shadow-md border border-slate-200 overflow-hidden flex flex-col justify-between transition"
                    >
                      <div>
                        <div class="relative h-48 bg-slate-200 overflow-hidden">
                          {item.image_url ? (
                            <img
                              src={item.image_url}
                              alt={item.title}
                              class={`w-full h-full object-cover transition duration-300 ${isBooked ? 'opacity-85' : 'hover:scale-105'}`}
                            />
                          ) : (
                            <div class="w-full h-full flex items-center justify-center text-xs font-bold text-slate-400">
                              Belum Ada Foto Sampul
                            </div>
                          )}
                          <div class="absolute top-3 left-3 right-3 flex items-center justify-between gap-2">
                            <span class={`text-[11px] font-bold px-2.5 py-1 rounded-md text-white ${
                              item.category === 'kos' ? 'bg-indigo-600' :
                              item.category === 'rumah' ? 'bg-blue-600' : 'bg-amber-600'
                            }`}>
                              {(item.category || 'PROPERTI').toUpperCase()}
                            </span>
                            <span class={`text-[10px] font-extrabold px-2.5 py-1 rounded-md text-white ${isBooked ? 'bg-rose-600' : 'bg-emerald-600'}`}>
                              {isBooked ? 'TERKUNCI' : 'TERSEDIA'}
                            </span>
                          </div>

                          <div class="absolute bottom-2.5 left-3 flex items-center gap-1.5">
                            <button
                              type="button"
                              data-like-id={item.id}
                              aria-label="Sukai properti"
                              title="Sukai Properti"
                              class="btn-like-prop w-8 h-8 rounded-full bg-white/95 hover:bg-white text-slate-600 shadow-md flex items-center justify-center transition cursor-pointer"
                            >
                              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                              </svg>
                            </button>
                            <button
                              type="button"
                              data-save-id={item.id}
                              aria-label="Simpan properti"
                              title="Simpan Properti"
                              class="btn-save-prop w-8 h-8 rounded-full bg-white/95 hover:bg-white text-slate-600 shadow-md flex items-center justify-center transition cursor-pointer"
                            >
                              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
                              </svg>
                            </button>
                          </div>

                          {totalPhotos > 1 && (
                            <span class="absolute bottom-2.5 right-2.5 px-2 py-0.5 rounded bg-slate-950/75 text-white text-[10px] font-bold">
                              {totalPhotos} Foto
                            </span>
                          )}
                        </div>

                        <div class="p-5">
                          <h2 class="text-base font-bold text-slate-900 line-clamp-1">{item.title}</h2>
                          <p class="text-slate-500 text-xs mt-1 truncate">{item.location}</p>

                          {quickSpecs.length > 0 && (
                            <div class="flex flex-wrap gap-1.5 mt-3">
                              {quickSpecs.map((badge) => (
                                <span class="text-[10px] font-semibold px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 border border-slate-200/80">
                                  {badge}
                                </span>
                              ))}
                            </div>
                          )}

                          <div class="mt-4 pt-3 border-t border-slate-100">
                            <span class="text-[11px] text-slate-400 block">Harga Ditawarkan:</span>
                            <p class="text-base font-extrabold text-[#059669]">
                              Rp {Number(item.price || 0).toLocaleString('id-ID')}
                              <span class="text-xs font-normal text-slate-500">/{item.price_unit || 'bulan'}</span>
                            </p>
                          </div>
                        </div>
                      </div>

                      <div class="p-5 pt-0 flex items-center gap-2">
                        <a
                          href={`/property/${item.id}`}
                          class={`flex-1 flex items-center justify-center gap-2 font-semibold text-xs py-2.5 rounded-lg transition ${
                            isBooked ? 'bg-slate-200 hover:bg-slate-300 text-slate-700' : 'bg-[#059669] hover:bg-emerald-700 text-white'
                          }`}
                        >
                          {isBooked ? 'Lihat Detail (Sudah Terkunci)' : 'Detail & Ajukan Booking'}
                        </a>
                      </div>
                    </article>
                  );
                })}
              </div>

              <div id="no-results" class="hidden text-center py-16 bg-white rounded-xl border border-slate-200 mt-4">
                <h3 class="text-sm font-bold text-slate-700">Unit Properti Tidak Ditemukan</h3>
                <p class="text-xs text-slate-400 mt-1">Coba kata kunci lokasi lain atau pilih kategori Semua.</p>
              </div>
            </div>
          ) : (
            <div id="empty-state" class="text-center py-16 bg-white rounded-xl border border-slate-200">
              <h3 class="text-sm font-bold text-slate-700">Belum Ada Properti Terdaftar</h3>
            </div>
          )}
        </div>
      </main>
    </div>

    <div id="catalog-toast" class="hidden fixed bottom-6 left-1/2 -translate-x-1/2 z-50 px-4 py-2.5 rounded-xl bg-slate-900 text-white text-xs font-bold shadow-xl border border-slate-700"></div>

    <Footer />

    <script is:inline>
      const filterButtons = document.querySelectorAll('.filter-btn');
      const searchInput = document.getElementById('search-input');
      const searchBtn = document.getElementById('search-btn');
      const visibleCountEl = document.getElementById('visible-count');
      const noResultsEl = document.getElementById('no-results');
      const toastEl = document.getElementById('catalog-toast');
      let currentCategory = 'all';
      let toastTimer = null;

      function getAuthSession() {
        try {
          const raw = localStorage.getItem('ip_auth_user');
          if (!raw) return null;
          const parsed = JSON.parse(raw);
          if (!parsed || typeof parsed !== 'object') return null;
          const id = parsed.id ? String(parsed.id).trim() : '';
          const email = parsed.email ? String(parsed.email).trim().toLowerCase() : '';
          return {
            id: id || email || '',
            email,
            name: parsed.name || '',
            role: String(parsed.role || 'BUYER').toUpperCase()
          };
        } catch {
          return null;
        }
      }

      function getStorageKeys() {
        const s = getAuthSession();
        const scope = s?.id ? encodeURIComponent(s.id) : 'guest';
        return {
          liked: `ip_liked_props_${scope}`,
          saved: `ip_saved_props_${scope}`,
          isLoggedIn: Boolean(s?.id)
        };
      }

      function readIds(key) {
        try {
          const arr = JSON.parse(localStorage.getItem(key) || '[]');
          return Array.isArray(arr) ? arr.map(String) : [];
        } catch {
          return [];
        }
      }

      function writeIds(key, arr) {
        localStorage.setItem(key, JSON.stringify([...new Set(arr.map(String))]));
      }

      function showToast(msg) {
        if (!toastEl) return;
        toastEl.textContent = msg;
        toastEl.classList.remove('hidden');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => toastEl.classList.add('hidden'), 2400);
      }

      function syncCardActionStates() {
        const keys = getStorageKeys();
        const likedIds = readIds(keys.liked);
        const savedIds = readIds(keys.saved);

        document.querySelectorAll('.btn-like-prop').forEach((btn) => {
          const id = String(btn.getAttribute('data-like-id') || '');
          const active = likedIds.includes(id);
          const svg = btn.querySelector('svg');
          btn.classList.toggle('bg-rose-500', active);
          btn.classList.toggle('text-white', active);
          btn.classList.toggle('bg-white/95', !active);
          btn.classList.toggle('text-slate-600', !active);
          if (svg) svg.setAttribute('fill', active ? 'currentColor' : 'none');
        });

        document.querySelectorAll('.btn-save-prop').forEach((btn) => {
          const id = String(btn.getAttribute('data-save-id') || '');
          const active = savedIds.includes(id);
          const svg = btn.querySelector('svg');
          btn.classList.toggle('bg-amber-500', active);
          btn.classList.toggle('text-white', active);
          btn.classList.toggle('bg-white/95', !active);
          btn.classList.toggle('text-slate-600', !active);
          if (svg) svg.setAttribute('fill', active ? 'currentColor' : 'none');
        });

        const total = new Set([...likedIds, ...savedIds]).size;
        const shortcut = document.getElementById('saved-shortcut-link');
        const totalBadge = document.getElementById('nav-saved-total');
        if (shortcut && totalBadge) {
          totalBadge.textContent = String(total);
          shortcut.classList.toggle('hidden', !(keys.isLoggedIn && total > 0));
        }
      }

      function bindCardActions() {
        document.querySelectorAll('.btn-like-prop').forEach((btn) => {
          if (btn.dataset.bound === 'true') return;
          btn.dataset.bound = 'true';
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            const keys = getStorageKeys();
            if (!keys.isLoggedIn) {
              showToast('Masuk ke akun terlebih dahulu untuk menyukai properti.');
              setTimeout(() => {
                window.location.href = '/masuk';
              }, 700);
              return;
            }
            const id = String(btn.getAttribute('data-like-id') || '');
            const list = readIds(keys.liked);
            const exists = list.includes(id);
            const next = exists ? list.filter((x) => x !== id) : [id, ...list];
            writeIds(keys.liked, next);
            syncCardActionStates();
            showToast(exists ? 'Dihapus dari daftar disukai.' : 'Ditambahkan ke properti disukai (Profil).');
          });
        });

        document.querySelectorAll('.btn-save-prop').forEach((btn) => {
          if (btn.dataset.bound === 'true') return;
          btn.dataset.bound = 'true';
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            const keys = getStorageKeys();
            if (!keys.isLoggedIn) {
              showToast('Masuk ke akun terlebih dahulu untuk menyimpan properti.');
              setTimeout(() => {
                window.location.href = '/masuk';
              }, 700);
              return;
            }
            const id = String(btn.getAttribute('data-save-id') || '');
            const list = readIds(keys.saved);
            const exists = list.includes(id);
            const next = exists ? list.filter((x) => x !== id) : [id, ...list];
            writeIds(keys.saved, next);
            syncCardActionStates();
            showToast(exists ? 'Dihapus dari daftar tersimpan.' : 'Properti disimpan ke Profil Anda.');
          });
        });

        syncCardActionStates();
      }

      function getCards() {
        return document.querySelectorAll('.property-card');
      }

      function applyFilter() {
        const cards = getCards();
        const query = (searchInput?.value || '').toLowerCase().trim();
        let count = 0;

        cards.forEach((card) => {
          const cat = card.getAttribute('data-category') || '';
          const meta = card.getAttribute('data-search') || '';
          const match = (currentCategory === 'all' || cat === currentCategory) && (query === '' || meta.includes(query));
          card.style.display = match ? 'flex' : 'none';
          if (match) count++;
        });

        if (visibleCountEl) visibleCountEl.textContent = String(count);
        if (noResultsEl) noResultsEl.classList.toggle('hidden', !(count === 0 && cards.length > 0));
      }

      filterButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          filterButtons.forEach((b) => {
            b.classList.remove('bg-[#0F172A]', 'text-white', 'border-slate-800');
            b.classList.add('bg-white', 'text-slate-600', 'border-slate-200');
          });
          btn.classList.remove('bg-white', 'text-slate-600', 'border-slate-200');
          btn.classList.add('bg-[#0F172A]', 'text-white', 'border-slate-800');
          currentCategory = btn.getAttribute('data-filter') || 'all';
          applyFilter();
        });
      });

      searchInput?.addEventListener('input', applyFilter);
      searchBtn?.addEventListener('click', applyFilter);
      window.addEventListener('focus', syncCardActionStates);
      window.addEventListener('storage', syncCardActionStates);

      bindCardActions();
    </script>
  </body>
</html>
