---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hubungi Kontak — InfoProperti</title>
    <meta name="description" content="Hubungi tim InfoProperti untuk jadwal survei lokasi, pengecekan unit Kos, Rumah, atau Kavling Tanah, dan bantuan transaksi." />
    <link rel="canonical" href="https://infoproperti.web.id/kontak" />
    <style is:global>
      @import '../styles/global.css';
    </style>
  </head>
  <body class="bg-slate-50 text-slate-900 font-sans min-h-screen flex flex-col justify-between">
    <div>
      <Navbar active="kontak" />

      <!-- HERO SECTION RATA TENGAH -->
      <section class="bg-[#0F172A] text-white py-14 px-4 border-b border-slate-800">
        <div class="max-w-4xl mx-auto text-center">
          <span class="inline-block px-3.5 py-1 bg-emerald-500/10 border border-emerald-500/30 rounded-full text-xs font-semibold text-emerald-400 mb-3">
            Layanan Bantuan Pembeli
          </span>
          <h1 class="text-3xl md:text-4xl font-extrabold">Hubungi Tim InfoProperti</h1>
          <p class="text-slate-300 text-xs sm:text-sm mt-2.5 max-w-2xl mx-auto leading-relaxed">
            Butuh bantuan jadwal survei lokasi atau pengecekan status booking? Kirim pesan langsung melalui formulir atau WhatsApp resmi kami.
          </p>
        </div>
      </section>

      <main class="max-w-5xl mx-auto px-4 py-12 grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-xs space-y-5 text-xs">
          <div>
            <h2 class="text-base font-extrabold text-slate-900">Informasi Kantor & Layanan</h2>
            <p class="text-slate-500 mt-1">Jam operasional layanan konsultasi unit: Senin – Sabtu, 08.00 – 17.00 WIB.</p>
          </div>
          <div class="space-y-3">
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200">
              <span class="text-slate-400 block">Alamat Kantor Layanan</span>
              <strong class="text-slate-800">Jl. Soekarno Hatta No. 45, Lowokwaru, Kota Malang, Jawa Timur</strong>
            </div>
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200">
              <span class="text-slate-400 block">Email Bantuan</span>
              <strong class="text-slate-800">halo@infoproperti.web.id</strong>
            </div>
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200">
              <span class="text-slate-400 block">WhatsApp Layanan Survei</span>
              <strong class="text-emerald-700">+62 812-3456-7890</strong>
            </div>
          </div>
        </div>

        <form id="contact-form" class="bg-white p-6 rounded-2xl border border-slate-200 shadow-xs space-y-4">
          <h2 class="text-base font-extrabold text-slate-900">Kirim Pertanyaan Langsung</h2>
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Nama Lengkap</label>
            <input type="text" id="c-name" required placeholder="Nama Anda" class="w-full text-xs px-3.5 py-2.5 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-[#059669]" />
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Kategori Pertanyaan</label>
            <select id="c-topic" class="w-full text-xs px-3.5 py-2.5 rounded-lg border border-slate-300 bg-white focus:outline-none focus:ring-2 focus:ring-[#059669]">
              <option value="Jadwal Survei Lokasi">Jadwal Survei Lokasi</option>
              <option value="Ketersediaan Unit Kos / Rumah">Ketersediaan Unit Kos / Rumah</option>
              <option value="Bantuan Pembayaran & E-Receipt">Bantuan Pembayaran & E-Receipt</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Pesan Anda</label>
            <textarea id="c-msg" rows="3" required placeholder="Tuliskan pertanyaan atau unit yang ingin disurvei..." class="w-full text-xs px-3.5 py-2.5 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-[#059669]"></textarea>
          </div>
          <button type="submit" class="w-full bg-[#059669] hover:bg-emerald-700 text-white font-bold text-xs py-3 rounded-xl transition cursor-pointer">
            Kirim Pesan via WhatsApp
          </button>
        </form>
      </main>
    </div>

    <Footer />

    <script is:inline>
      document.getElementById('contact-form')?.addEventListener('submit', (e) => {
        e.preventDefault();
        const name = document.getElementById('c-name').value;
        const topic = document.getElementById('c-topic').value;
        const msg = document.getElementById('c-msg').value;
        const text = `Halo Admin InfoProperti,\nNama: *${name}*\nTopik: *${topic}*\nPesan: ${msg}`;
        window.open(`https://wa.me/6281234567890?text=${encodeURIComponent(text)}`, '_blank');
      });
    </script>
  </body>
</html>
