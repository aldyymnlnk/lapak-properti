---
// src/pages/blog/biaya-jual-beli-rumah.astro
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const pageTitle = "Biaya Jual Beli Rumah yang Wajib Kamu Siapkan";
const pageDesc = "Hitung biaya jual beli rumah lengkap: BPHTB, PPh final, notaris, dan balik nama. Lihat contoh simulasi dan siapkan dananya. Baca panduannya sekarang!";
const publishDate = "2026-11-24";
const publishIsoDate = "2026-11-24T18:00:00+07:00";
const publishDisplayDate = "24 November 2026 • 18:00 WIB";
const pageSlug = "/blog/biaya-jual-beli-rumah";
const pageUrl = `https://infoproperti.web.id${pageSlug}`;
const ogImageUrl = "https://infoproperti.web.id/assets/img/biaya-jual-beli-rumah-pajak-dan-notaris.webp";
const secondImageUrl = "https://infoproperti.web.id/assets/img/simulasi-pajak-bphtb-dan-pph-final-rumah.webp";
const authorName = "Aldi Rionaldi Simanullang";
const keywordsList = "biaya jual beli rumah, pajak jual beli rumah, BPHTB, pph final penjual, biaya notaris dan ppat, biaya balik nama, NPOPTKP, hitung biaya beli rumah";

const schemaArticle = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": `${pageUrl}#article`,
      "isPartOf": { "@id": pageUrl },
      "headline": pageTitle,
      "description": pageDesc,
      "keywords": keywordsList,
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": pageUrl
      },
      "image": [
        ogImageUrl,
        secondImageUrl
      ],
      "inLanguage": "id-ID",
      "datePublished": publishIsoDate,
      "dateModified": publishIsoDate,
      "author": {
        "@type": "Person",
        "name": authorName
      },
      "publisher": {
        "@type": "Organization",
        "name": "InfoProperti",
        "url": "https://infoproperti.web.id/",
        "logo": {
          "@type": "ImageObject",
          "url": "https://infoproperti.web.id/assets/img/lapak-properti-terpercaya.webp"
        }
      }
    },
    {
      "@type": "HowTo",
      "@id": `${pageUrl}#howto`,
      "name": "Cara menghitung biaya jual beli rumah",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Tentukan nilai transaksi",
          "text": "Catat harga jual yang disepakati dan bandingkan dengan NJOP untuk menentukan NPOP."
        },
        {
          "@type": "HowToStep",
          "name": "Hitung PPh final penjual",
          "text": "Kalikan nilai pengalihan dengan 2,5 persen, atau 1 persen untuk rumah sederhana."
        },
        {
          "@type": "HowToStep",
          "name": "Hitung BPHTB pembeli",
          "text": "Kurangi NPOP dengan NPOPTKP daerah, lalu kalikan dengan tarif BPHTB."
        },
        {
          "@type": "HowToStep",
          "name": "Tambahkan biaya PPAT dan balik nama",
          "text": "Minta rincian tertulis dari PPAT untuk honorarium dan biaya administrasi."
        },
        {
          "@type": "HowToStep",
          "name": "Sepakati pembagian biaya",
          "text": "Tuangkan pembagian biaya dalam kesepakatan tertulis sebelum tanda jadi."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": `${pageUrl}#faq`,
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Siapa yang membayar pajak jual beli rumah?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Penjual membayar PPh final atas pengalihan hak, sedangkan pembeli membayar BPHTB. Keduanya dibayar sebelum akta ditandatangani di hadapan PPAT. Pembagian biaya lain, seperti honorarium PPAT dan balik nama, bergantung pada kesepakatan tertulis kedua pihak. Catat pembagian itu bersama saksi agar tidak diperdebatkan di kemudian hari."
          }
        },
        {
          "@type": "Question",
          "name": "Berapa tarif PPh final penjual rumah?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tarif PPh final penjual adalah 2,5 persen dari nilai pengalihan untuk transaksi umum dan 1 persen untuk rumah sederhana atau rumah susun sederhana, sesuai PP 34/2016. Tarif 5 persen dari aturan lama sudah tidak berlaku lagi, jadi pastikan PPAT memakai tarif terbaru."
          }
        },
        {
          "@type": "Question",
          "name": "Apa itu NPOPTKP dalam perhitungan BPHTB?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "NPOPTKP adalah Nilai Perolehan Objek Pajak Tidak Kena Pajak, yaitu batas nilai yang dikurangkan dari NPOP sebelum BPHTB dihitung. Besarannya ditetapkan pemerintah daerah. Karena berbeda tiap daerah, tanyakan angka terbaru ke PPAT atau kantor pajak daerah setempat. Hasil pengecekan itu menjadi dasar perhitungan yang akurat bagi kedua pihak."
          }
        },
        {
          "@type": "Question",
          "name": "Berapa biaya notaris dan PPAT untuk jual beli rumah?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Honorarium PPAT atau notaris berbeda-beda dan umumnya bergantung pada nilai transaksi serta kompleksitas akta. Tidak ada satu angka yang berlaku untuk semua kantor. Minta rincian tertulis dan bandingkan beberapa penawaran sebelum menunjuk PPAT yang akan menangani akta jual beli. Kejelasan biaya sejak awal mencegah perselisihan menjelang akta."
          }
        },
        {
          "@type": "Question",
          "name": "Berapa biaya balik nama sertifikat rumah?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Biaya balik nama mencakup biaya pengecekan dan pendaftaran peralihan hak di kantor pertanahan, dan umumnya ditanggung pembeli. Besarannya bergantung pada nilai tanah dan ketentuan yang berlaku. Tanyakan estimasi kepada PPAT sejak awal agar bisa dimasukkan ke anggaran. Estimasi biaya yang jelas membantu kamu menyusun anggaran lebih akurat."
          }
        },
        {
          "@type": "Question",
          "name": "Apakah pajak dibayar sebelum atau sesudah akta?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "PPh final dan BPHTB dibayar sebelum akta jual beli ditandatangani. PPAT biasanya meminta bukti setor kedua pajak itu sebagai syarat pembuatan akta. Karena itu, siapkan dana pajak sejak tahap negosiasi, bukan menunggu jadwal akta. Pembayaran tepat waktu mencegah penundaan jadwal akta."
          }
        }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${pageUrl}#breadcrumb`,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Beranda",
          "item": "https://infoproperti.web.id/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Blog",
          "item": "https://infoproperti.web.id/blog"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Biaya Jual Beli Rumah yang Wajib Kamu Siapkan",
          "item": pageUrl
        }
      ]
    }
  ]
};
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle} — InfoProperti</title>
    <meta name="description" content={pageDesc} />
    <meta name="keywords" content={keywordsList} />
    <link rel="canonical" href={pageUrl} />

    <!-- Open Graph / Social Meta -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:alt" content="Rincian biaya jual beli rumah berupa BPHTB, PPh final, dan biaya notaris" />
    <meta property="og:type" content="article" />
    <meta property="article:published_time" content={publishIsoDate} />
    <meta property="article:modified_time" content={publishIsoDate} />
    <meta property="article:section" content="Panduan Biaya" />

    <script type="application/ld+json" set:html={JSON.stringify(schemaArticle)} />
    <style is:global>
      @import '../../styles/global.css';
    </style>
  </head>

  <body class="bg-slate-50 text-slate-900 font-sans min-h-screen flex flex-col justify-between">
    <div>
      <Navbar active="blog" />

      <section class="py-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">

          <!-- KONTEN UTAMA (KIRI) -->
          <article class="lg:col-span-8 bg-white p-6 md:p-10 rounded-3xl border border-slate-200/90 space-y-8 shadow-sm">

            <header class="space-y-4">
              <div class="flex flex-wrap items-center gap-3 text-xs font-mono text-slate-500">
                <span class="bg-emerald-600 text-white font-bold px-3 py-1 rounded-full uppercase">Panduan Biaya</span>
                <time datetime={publishIsoDate}>{publishDisplayDate}</time>
                <span>•</span>
                <span>Oleh <strong class="text-slate-800">{authorName}</strong></span>
              </div>
              <h1 class="text-2xl md:text-4xl font-extrabold text-slate-900 leading-tight">
                {pageTitle}
              </h1>
              <p class="text-slate-600 text-sm md:text-base leading-relaxed">
                {pageDesc}
              </p>
            </header>

            <!-- Gambar 1 -->
            <figure class="rounded-2xl overflow-hidden border border-slate-200 bg-slate-100">
              <img
                src="/assets/img/biaya-jual-beli-rumah-pajak-dan-notaris.webp"
                alt="Rincian biaya jual beli rumah berupa BPHTB, PPh final, dan biaya notaris"
                class="w-full h-auto max-h-[420px] object-cover"
                loading="eager"
              />
              <figcaption class="text-center text-slate-500 text-xs p-2.5 bg-slate-50 border-t border-slate-200">
                Rincian biaya jual beli rumah berupa BPHTB, PPh final, dan biaya notaris.
              </figcaption>
            </figure>

            <!-- TOC -->
            <div class="bg-slate-50 p-5 rounded-2xl border border-slate-200 space-y-3">
              <button type="button" id="toc-toggle" class="w-full flex justify-between items-center text-emerald-700 font-bold text-sm cursor-pointer">
                <span>Daftar Isi Panduan</span>
                <span id="toc-icon" class="text-xs font-bold text-emerald-600" style="font-variant-emoji: text;">▼</span>
              </button>
              <div id="toc-content" class="text-xs text-slate-600 space-y-2 pt-2 border-t border-slate-200">
                <ul class="space-y-1.5 list-disc list-inside">
                  <li><a href="#komponen-biaya" class="hover:text-emerald-700 transition-colors">1. Apa Saja Komponen Biaya Jual Beli Rumah?</a></li>
                  <li><a href="#cara-menghitung-pajak" class="hover:text-emerald-700 transition-colors">2. Bagaimana Cara Menghitung BPHTB dan PPh Final?</a></li>
                  <li><a href="#menyiapkan-dana" class="hover:text-emerald-700 transition-colors">3. Bagaimana Menyiapkan Dana dan Menyepakati Pembagian Biaya?</a></li>
                  <li><a href="#faq-section" class="hover:text-emerald-700 transition-colors">4. Pertanyaan Umum tentang Biaya Jual Beli Rumah</a></li>
                  <li><a href="#langkah-selanjutnya" class="hover:text-emerald-700 transition-colors">5. Langkah Selanjutnya Menyiapkan Biaya Transaksi</a></li>
                </ul>
              </div>
            </div>

            <div class="space-y-8 text-slate-700 text-sm md:text-base leading-relaxed">
              <div class="space-y-4">
                <p>
                  <strong>Biaya jual beli rumah</strong> meliputi PPh final penjual, BPHTB pembeli, jasa PPAT, serta biaya pengecekan dan balik nama yang bergantung pada nilai transaksi dan daerah.
                </p>
                <p>
                  Banyak pembeli pertama menyiapkan dana hanya sebesar harga rumah, lalu kaget saat tagihan pajak dan jasa PPAT muncul menjelang akta. Penjual pun sering lupa bahwa ada pajak penghasilan yang harus dibayar sebelum akta ditandatangani.
                </p>
                <p>
                  Panduan ini membantu kamu menghitung biaya beli rumah dari kedua sisi, lengkap dengan contoh simulasi. Gambaran transaksi secara utuh ada di <a href="/blog/lapak-properti" class="text-emerald-700 font-semibold underline hover:text-emerald-800">panduan lapak properti</a>. Angka dalam contoh bersifat ilustrasi dan perlu dikonfirmasi ke PPAT serta pemerintah daerah.
                </p>
              </div>

              <section id="komponen-biaya" class="space-y-4">
                <h2 class="text-xl md:text-2xl font-bold text-slate-900">Apa Saja Komponen Biaya Jual Beli Rumah?</h2>
                <p>
                  Ada empat komponen utama: pajak penjual, pajak pembeli, honorarium PPAT atau notaris, dan biaya administrasi pendaftaran peralihan hak di kantor pertanahan.
                </p>
                <p>
                  Tabel berikut merangkum siapa yang umumnya menanggung tiap komponen. Pembagian ini bisa berbeda, sehingga selalu sepakati secara tertulis.
                </p>

                <div class="overflow-x-auto rounded-2xl border border-slate-200">
                  <table class="w-full text-left text-xs md:text-sm border-collapse">
                    <thead class="bg-[#0F172A] text-white">
                      <tr>
                        <th class="p-3.5 font-bold">Komponen</th>
                        <th class="p-3.5 font-bold">Umumnya ditanggung</th>
                        <th class="p-3.5 font-bold">Keterangan</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-200 bg-white">
                      <tr>
                        <td class="p-3.5 font-semibold text-slate-900">PPh final</td>
                        <td class="p-3.5">Penjual</td>
                        <td class="p-3.5">2,5 persen dari nilai pengalihan, atau 1 persen untuk rumah sederhana</td>
                      </tr>
                      <tr class="bg-slate-50/70">
                        <td class="p-3.5 font-semibold text-slate-900">BPHTB</td>
                        <td class="p-3.5">Pembeli</td>
                        <td class="p-3.5">Tarif maksimal 5 persen dari NPOP dikurangi NPOPTKP, ditetapkan daerah</td>
                      </tr>
                      <tr>
                        <td class="p-3.5 font-semibold text-slate-900">Jasa PPAT atau notaris</td>
                        <td class="p-3.5">Sesuai kesepakatan</td>
                        <td class="p-3.5">Honorarium akta berbeda tiap PPAT, minta rincian tertulis</td>
                      </tr>
                      <tr class="bg-slate-50/70">
                        <td class="p-3.5 font-semibold text-slate-900">Pengecekan sertifikat dan balik nama</td>
                        <td class="p-3.5">Pembeli, umumnya</td>
                        <td class="p-3.5">Biaya administrasi dan PNBP di kantor pertanahan</td>
                      </tr>
                      <tr>
                        <td class="p-3.5 font-semibold text-slate-900">Biaya lain</td>
                        <td class="p-3.5">Sesuai kesepakatan</td>
                        <td class="p-3.5">Komisi agen dan biaya pencoretan hak tanggungan bila ada</td>
                      </tr>
                    </tbody>
                  </table>
                </div>

                <h3 class="text-lg md:text-xl font-bold text-slate-900 pt-2">Pajak Jual Beli Rumah yang Dibayar Penjual</h3>
                <p>
                  Penjual membayar pajak penghasilan final atas pengalihan hak tanah dan bangunan. Besaran PPh final penjual mengacu pada PP 34/2016, yaitu 2,5 persen dari nilai pengalihan untuk transaksi umum dan 1 persen untuk rumah sederhana atau rumah susun sederhana.
                </p>
                <p>
                  Pembayaran dilakukan sebelum akta jual beli ditandatangani, dan bukti setornya diserahkan kepada PPAT. Tarif lama 5 persen sudah tidak berlaku lagi.
                </p>

                <h3 class="text-lg md:text-xl font-bold text-slate-900 pt-2">Pajak yang Dibayar Pembeli: BPHTB</h3>
                <p>
                  Pembeli membayar Bea Perolehan Hak atas Tanah dan Bangunan (BPHTB). Tarifnya ditetapkan maksimal 5 persen, dengan besaran pastinya diatur masing-masing daerah. BPHTB dibayar sebelum akta ditandatangani di hadapan PPAT.
                </p>
              </section>

              <section id="cara-menghitung-pajak" class="space-y-4">
                <h2 class="text-xl md:text-2xl font-bold text-slate-900">Bagaimana Cara Menghitung BPHTB dan PPh Final?</h2>
                <p>
                  Hitung BPHTB dengan tarif dikalikan selisih NPOP dan NPOPTKP, lalu PPh final penjual 2,5 persen dari nilai pengalihan atau 1 persen untuk rumah sederhana.
                </p>

                <!-- Gambar 2 -->
                <figure class="rounded-2xl overflow-hidden border border-slate-200 bg-slate-100">
                  <img
                    src="/assets/img/simulasi-pajak-bphtb-dan-pph-final-rumah.webp"
                    alt="Simulasi perhitungan pajak jual beli rumah untuk penjual dan pembeli"
                    class="w-full h-auto max-h-[380px] object-cover"
                    loading="lazy"
                  />
                  <figcaption class="text-center text-slate-500 text-xs p-2.5 bg-slate-50 border-t border-slate-200">
                    Simulasi perhitungan pajak jual beli rumah untuk penjual dan pembeli.
                  </figcaption>
                </figure>

                <p>
                  Rumusnya sederhana: BPHTB terutang sama dengan tarif dikalikan (NPOP dikurangi NPOPTKP). NPOP adalah harga transaksi, tetapi bila lebih kecil dari NJOP maka dasar yang dipakai adalah NJOP. NPOPTKP adalah batas nilai yang tidak dikenai pajak dan ditetapkan masing-masing daerah.
                </p>

                <h3 class="text-lg md:text-xl font-bold text-slate-900 pt-2">Contoh Simulasi Rumah Rp 800 Juta</h3>
                <p>
                  Contoh berikut memakai NPOPTKP ilustrasi Rp 80 juta dan tarif BPHTB 5 persen. Angka asli di daerahmu bisa berbeda, jadi gunakan tabel ini hanya untuk gambaran.
                </p>

                <div class="overflow-x-auto rounded-2xl border border-slate-200">
                  <table class="w-full text-left text-xs md:text-sm border-collapse">
                    <thead class="bg-[#0F172A] text-white">
                      <tr>
                        <th class="p-3.5 font-bold">Komponen</th>
                        <th class="p-3.5 font-bold">Perhitungan</th>
                        <th class="p-3.5 font-bold">Hasil</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-200 bg-white">
                      <tr>
                        <td class="p-3.5 font-semibold text-slate-900">NPOP (harga transaksi)</td>
                        <td class="p-3.5">Harga yang disepakati</td>
                        <td class="p-3.5 font-semibold">Rp 800.000.000</td>
                      </tr>
                      <tr class="bg-slate-50/70">
                        <td class="p-3.5 font-semibold text-slate-900">NPOPTKP (ilustrasi)</td>
                        <td class="p-3.5">Ditetapkan daerah</td>
                        <td class="p-3.5">Rp 80.000.000</td>
                      </tr>
                      <tr>
                        <td class="p-3.5 font-semibold text-slate-900">Dasar BPHTB</td>
                        <td class="p-3.5">800 juta dikurangi 80 juta</td>
                        <td class="p-3.5">Rp 720.000.000</td>
                      </tr>
                      <tr class="bg-slate-50/70">
                        <td class="p-3.5 font-semibold text-slate-900">BPHTB pembeli</td>
                        <td class="p-3.5">5 persen dari 720 juta</td>
                        <td class="p-3.5 font-bold text-emerald-700">Rp 36.000.000</td>
                      </tr>
                      <tr>
                        <td class="p-3.5 font-semibold text-slate-900">PPh final penjual</td>
                        <td class="p-3.5">2,5 persen dari 800 juta</td>
                        <td class="p-3.5 font-bold text-emerald-700">Rp 20.000.000</td>
                      </tr>
                    </tbody>
                  </table>
                </div>

                <p>
                  Total pajak dalam contoh ini Rp 56 juta, belum termasuk honorarium PPAT, biaya pengecekan sertifikat, dan biaya balik nama. Gunakan pola ini untuk hitung biaya beli rumah sesuai harga dan daerahmu.
                </p>

                <h3 class="text-lg md:text-xl font-bold text-slate-900 pt-2">Mengapa Angka Setiap Daerah Berbeda</h3>
                <p>
                  NPOPTKP dan tarif BPHTB ditetapkan pemerintah daerah, sehingga rumah dengan harga sama bisa memiliki tagihan berbeda di dua kota. NJOP juga berbeda di tiap lokasi. Selalu konfirmasi angka final ke PPAT atau kantor pajak daerah sebelum menyiapkan dana.
                </p>
              </section>

              <!-- BACA JUGA BOX SISIPAN -->
              <div class="my-6">
                <a
                  href="/blog/cara-pasang-iklan-properti"
                  class="block bg-emerald-50/70 hover:bg-emerald-50 border-l-4 border-emerald-600 p-5 rounded-2xl border border-emerald-200 transition-all shadow-sm group"
                >
                  <div class="flex items-center justify-between">
                    <div>
                      <span class="text-xs font-bold text-emerald-700 uppercase tracking-wider block mb-1">BACA JUGA PANDUAN PENJUAL</span>
                      <h4 class="text-slate-900 font-bold text-sm md:text-base group-hover:text-emerald-700 transition-colors">
                        Cara Pasang Iklan Properti agar Cepat Laku &rarr;
                      </h4>
                    </div>
                  </div>
                </a>
              </div>

              <section id="menyiapkan-dana" class="space-y-4">
                <h2 class="text-xl md:text-2xl font-bold text-slate-900">Bagaimana Menyiapkan Dana dan Menyepakati Pembagian Biaya?</h2>
                <p>
                  Siapkan dana cadangan di atas harga properti, sepakati pembagian biaya tertulis sebelum tanda jadi, dan minta rincian tagihan dari PPAT agar tidak ada biaya mendadak.
                </p>
                <ul class="list-disc pl-5 space-y-2">
                  <li>Sisihkan dana cadangan di atas harga properti untuk pajak, PPAT, dan balik nama.</li>
                  <li>Minta simulasi biaya tertulis dari PPAT sebelum negosiasi harga final.</li>
                  <li>Tuangkan pembagian biaya dalam surat tanda jadi atau perjanjian pengikatan jual beli.</li>
                  <li>Simpan semua bukti setor pajak sebagai arsip pribadi.</li>
                  <li>Bagi penjual, siapkan dana PPh final sebelum akta dijadwalkan.</li>
                </ul>
                <p>
                  Biaya notaris dan PPAT berbeda tiap kantor, jadi bandingkan penawaran dan tanyakan komponen yang sudah termasuk. Biaya balik nama dihitung setelah akta, sehingga tanyakan estimasinya sejak awal.
                </p>
                <p>
