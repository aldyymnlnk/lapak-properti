---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const API_URL = (import.meta as any).env?.PUBLIC_API_URL || '';
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Daftar Akun Baru — InfoProperti</title>
    <meta name="description" content="Daftar akun Pembeli atau Agen di InfoProperti dan setujui Syarat & Ketentuan serta Kebijakan Privasi platform." />
    <link rel="canonical" href="https://infoproperti.web.id/daftar" />
    <style is:global>
      @import '../styles/global.css';
    </style>
  </head>
  <body class="bg-slate-50 text-slate-900 font-sans min-h-screen flex flex-col justify-between">
    <div>
      <Navbar active="daftar" />

      <main class="max-w-lg mx-auto px-4 py-12">
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 sm:p-8 space-y-6">
          <div>
            <h1 class="text-2xl font-extrabold text-slate-900">Daftar Akun Baru</h1>
            <p class="text-xs text-slate-500 mt-1">
              Pilih peran akun Anda di InfoProperti. Pendaftaran Agen memerlukan data verifikasi identitas (KTP).
            </p>
          </div>

          <!-- Pilihan 2 Role: Pembeli atau Agen -->
          <div class="grid grid-cols-2 gap-2 p-1.5 bg-slate-100 rounded-xl text-xs font-bold">
            <button
              type="button"
              id="role-buyer"
              data-role="BUYER"
              class="role-tab py-2.5 rounded-lg bg-[#0F172A] text-white shadow-2xs cursor-pointer transition"
            >
              Pembeli
            </button>
            <button
              type="button"
              id="role-agent"
              data-role="AGENT"
              class="role-tab py-2.5 rounded-lg text-slate-600 hover:text-slate-900 cursor-pointer transition"
            >
              Agen
            </button>
          </div>

          <div id="reg-alert" class="hidden p-3 rounded-xl text-xs font-semibold"></div>

          <form id="register-form" class="space-y-4 text-xs">
            <input type="hidden" id="selected-role" value="BUYER" />

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label class="block font-bold text-slate-700 mb-1">Nama Lengkap *</label>
                <input
                  type="text"
                  id="reg-name"
                  required
                  placeholder="Nama Lengkap"
                  class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-[#059669]"
                />
              </div>
              <div>
                <label class="block font-bold text-slate-700 mb-1">Username *</label>
                <input
                  type="text"
                  id="reg-username"
                  required
                  placeholder="username_anda"
                  class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-[#059669]"
                />
              </div>
            </div>

            <div>
              <label class="block font-bold text-slate-700 mb-1">Nomor WhatsApp *</label>
              <div class="flex rounded-xl border border-slate-300 overflow-hidden focus-within:ring-2 focus-within:ring-[#059669]">
                <span class="px-3 py-2.5 bg-slate-100 text-slate-700 font-bold border-r border-slate-300 flex items-center">
                  +62
                </span>
                <input
                  type="tel"
                  id="reg-phone"
                  required
                  placeholder="81234567890"
                  class="w-full px-3.5 py-2.5 focus:outline-none"
                />
              </div>
            </div>

            <div>
              <label class="block font-bold text-slate-700 mb-1">Alamat Email *</label>
              <input
                type="email"
                id="reg-email"
                required
                placeholder="nama@email.com"
                class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-[#059669]"
              />
            </div>

            <!-- Kolom Syarat Khusus Agen (KTP / NIK) -->
            <div id="agent-requirements" class="hidden p-4 rounded-xl bg-amber-50/70 border border-amber-200 space-y-3">
              <p class="text-[11px] font-extrabold text-amber-900 uppercase tracking-wider">
                Persyaratan Verifikasi Agen
              </p>
              <div>
                <label class="block font-bold text-slate-700 mb-1">Nomor Induk Kependudukan (NIK KTP 16 Digit)</label>
                <input
                  type="text"
                  id="reg-nik"
                  maxlength="16"
                  pattern="[0-9]{16}"
                  placeholder="357301xxxxxxxxxx"
                  class="w-full px-3.5 py-2 rounded-xl border border-slate-300 bg-white font-mono focus:outline-none focus:ring-2 focus:ring-[#059669]"
                />
              </div>
              <div>
                <label class="block font-bold text-slate-700 mb-1">Upload Foto KTP</label>
                <input
                  type="file"
                  id="reg-ktp-file"
                  accept="image/*"
                  class="w-full text-[11px] text-slate-600 file:mr-3 file:py-2 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-bold file:bg-amber-100 file:text-amber-900 hover:file:bg-amber-200 cursor-pointer"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label class="block font-bold text-slate-700 mb-1">Password *</label>
                <input
                  type="password"
                  id="reg-password"
                  required
                  minlength="8"
                  placeholder="Minimal 8 karakter"
                  class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-[#059669]"
                />
              </div>
              <div>
                <label class="block font-bold text-slate-700 mb-1">Ulangi Password *</label>
                <input
                  type="password"
                  id="reg-password-confirm"
                  required
                  minlength="8"
                  placeholder="Ketik ulang password"
                  class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-[#059669]"
                />
              </div>
            </div>

            <button
              type="submit"
              id="btn-daftar"
              class="w-full bg-[#059669] hover:bg-emerald-700 text-white font-extrabold text-sm py-3 rounded-xl shadow-xs transition cursor-pointer"
            >
              Daftar Sekarang
            </button>
          </form>

          <div class="text-center space-y-2 pt-2 border-t border-slate-100 text-xs">
            <p class="text-slate-600">
              Sudah punya akun?
              <a href="/masuk" class="font-bold text-[#059669] hover:underline">Masuk</a> sekarang
            </p>
            <p class="text-[11px] text-slate-500 leading-relaxed">
              Dengan Melanjutkan, Anda menyetujui
              <a href="/syarat-ketentuan" class="font-bold text-slate-800 underline hover:text-[#059669]">Syarat &amp; Ketentuan</a>
              dan
              <a href="/kebijakan-privasi" class="font-bold text-slate-800 underline hover:text-[#059669]">Kebijakan Privasi</a>
              InfoProperti.
            </p>
          </div>
        </div>
      </main>
    </div>

    <Footer />

    <script is:inline define:vars={{ apiUrl: API_URL }}>
      const API_BASE = apiUrl || '';
      const roleTabs = document.querySelectorAll('.role-tab');
      const roleInput = document.getElementById('selected-role');
      const agentReqBox = document.getElementById('agent-requirements');
      const nikInput = document.getElementById('reg-nik');
      const ktpInput = document.getElementById('reg-ktp-file');
      const alertBox = document.getElementById('reg-alert');
      let ktpBase64 = '';

      roleTabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          roleTabs.forEach((t) => {
            t.className = 'role-tab py-2.5 rounded-lg text-slate-600 hover:text-slate-900 cursor-pointer transition';
          });
          tab.className = 'role-tab py-2.5 rounded-lg bg-[#0F172A] text-white shadow-2xs cursor-pointer transition';

          const role = tab.getAttribute('data-role') || 'BUYER';
          if (roleInput) roleInput.value = role;

          const isAgent = role === 'AGENT';
          if (agentReqBox) agentReqBox.classList.toggle('hidden', !isAgent);
          if (nikInput) nikInput.required = isAgent;
          if (ktpInput) ktpInput.required = isAgent;
        });
      });

      ktpInput?.addEventListener('change', (e) => {
        const file = e.target.files && e.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = (ev) => {
          ktpBase64 = String(ev.target?.result || '');
        };
        reader.readAsDataURL(file);
      });

      function showAlert(msg, isErr = true) {
        alertBox.textContent = msg;
        alertBox.className = `p-3 rounded-xl text-xs font-semibold ${
          isErr ? 'bg-rose-50 text-rose-700 border border-rose-200' : 'bg-emerald-50 text-emerald-700 border border-emerald-200'
        }`;
        alertBox.classList.remove('hidden');
      }

      document.getElementById('register-form')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const pass = document.getElementById('reg-password').value;
        const passConfirm = document.getElementById('reg-password-confirm').value;
        if (pass.length < 8) {
          showAlert('Kata sandi minimal 8 karakter.');
          return;
        }
        if (pass !== passConfirm) {
          showAlert('Konfirmasi password tidak cocok.');
          return;
        }

        const role = roleInput?.value || 'BUYER';
        const rawPhone = document.getElementById('reg-phone').value.replace(/^0+/, '').trim();
        const fullPhone = `62${rawPhone}`;
        const btn = document.getElementById('btn-daftar');
        btn.disabled = true;
        btn.textContent = 'Mendaftarkan...';

        try {
          const res = await fetch(`${API_BASE}/api/auth/register`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              name: document.getElementById('reg-name').value.trim(),
              username: document.getElementById('reg-username').value.trim(),
              phone: fullPhone,
              email: document.getElementById('reg-email').value.trim(),
              password: pass,
              role,
              nik: role === 'AGENT' ? nikInput?.value.trim() : undefined,
              ktp_image_url: role === 'AGENT' ? ktpBase64 : undefined
            })
          });
          const data = await res.json();
          if (res.ok) {
            showAlert(
              role === 'AGENT'
                ? 'Pendaftaran Agen terkirim! Menunggu verifikasi KTP oleh Admin/Super Admin.'
                : 'Akun Pembeli berhasil dibuat! Mengalihkan ke halaman masuk...',
              false
            );
            setTimeout(() => {
              window.location.href = '/masuk';
            }, 1200);
          } else {
            showAlert(data.error || 'Gagal mendaftar.');
            btn.disabled = false;
            btn.textContent = 'Daftar Sekarang';
          }
        } catch {
          showAlert('Gagal terhubung ke server.');
          btn.disabled = false;
          btn.textContent = 'Daftar Sekarang';
        }
      });
    </script>
  </body>
</html>