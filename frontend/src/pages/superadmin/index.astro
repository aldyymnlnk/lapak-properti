---
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const API_URL = (import.meta as any).env?.PUBLIC_API_URL || '';
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Panel Super Admin — InfoProperti</title>
    <meta name="robots" content="noindex, nofollow" />
    <style is:global>
      @import '../../styles/global.css';
    </style>
  </head>
  <body class="bg-slate-50 text-slate-900 font-sans min-h-screen flex flex-col justify-between">
    <div>
      <Navbar active="superadmin" />

      <section class="bg-[#0F172A] text-white py-10 px-4 border-b border-slate-800">
        <div class="max-w-6xl mx-auto flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <div class="flex items-center gap-2 mb-2">
              <span class="px-2.5 py-0.5 rounded bg-amber-500 text-slate-950 text-[10px] font-black uppercase tracking-wider">
                SUPER ADMIN CONTROL
              </span>
              <span id="sa-user-badge" class="text-xs text-slate-400">Memuat sesi...</span>
            </div>
            <h1 class="text-2xl md:text-3xl font-extrabold">Pusat Kendali Sistem &amp; Otoritas Pengguna</h1>
            <p class="text-xs text-slate-300 mt-1">
              Kelola akun Admin &amp; Agen (termasuk verifikasi pendaftaran Agen), pantau seluruh unit properti, dan sinkronkan data.
            </p>
          </div>

          <div class="flex flex-wrap items-center gap-2.5">
            <a href="/superadmin/properties" class="px-4 py-2.5 rounded-xl bg-[#059669] hover:bg-emerald-700 text-white text-xs font-bold transition">
              Kelola Katalog Properti &rarr;
            </a>
            <a href="/admin" class="px-4 py-2.5 rounded-xl bg-emerald-600/20 hover:bg-emerald-600/30 border border-emerald-500/30 text-emerald-300 text-xs font-bold transition">
              Operasional Admin &rarr;
            </a>
            <button type="button" id="btn-sync-sheets" class="px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-xs font-bold cursor-pointer transition">
              Sync Google Sheets
            </button>
          </div>
        </div>
      </section>

      <main class="max-w-6xl mx-auto px-4 py-8 space-y-8">
        <section class="grid grid-cols-2 lg:grid-cols-4 gap-4">
          <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-xs">
            <span class="text-[11px] font-bold text-slate-400 uppercase">Total Unit Properti</span>
            <strong id="stat-props" class="block text-2xl font-black text-slate-900 mt-1">0</strong>
            <span id="stat-booked" class="text-[11px] text-emerald-600 font-semibold">0 unit terkunci</span>
          </div>
          <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-xs">
            <span class="text-[11px] font-bold text-slate-400 uppercase">Total Pengajuan</span>
            <strong id="stat-orders" class="block text-2xl font-black text-blue-600 mt-1">0</strong>
            <span id="stat-pending" class="text-[11px] text-amber-600 font-semibold">0 menunggu verifikasi</span>
          </div>
          <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-xs">
            <span class="text-[11px] font-bold text-slate-400 uppercase">Admin Operasional</span>
            <strong id="stat-admins" class="block text-2xl font-black text-indigo-600 mt-1">0</strong>
            <span class="text-[11px] text-slate-500">Akun terdaftar</span>
          </div>
          <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-xs">
            <span class="text-[11px] font-bold text-slate-400 uppercase">Mitra Agen</span>
            <strong id="stat-agents" class="block text-2xl font-black text-[#059669] mt-1">0</strong>
            <span id="stat-agents-pending" class="text-[11px] text-amber-600 font-semibold">0 menunggu aktif</span>
          </div>
        </section>

        <!-- ANTREAN VERIFIKASI AGEN -->
        <section id="agent-queue" class="bg-white rounded-2xl border-2 border-amber-300/70 shadow-xs overflow-hidden">
          <div class="p-5 border-b border-amber-100 bg-amber-50/60 flex flex-wrap items-center justify-between gap-3">
            <div>
              <span class="text-[10px] font-extrabold uppercase tracking-wider text-amber-700">Perlu Tindakan</span>
              <h2 class="text-base font-extrabold text-slate-900">
                Antrean Verifikasi Agen
                <span id="agent-queue-count" class="ml-1.5 px-2 py-0.5 rounded-full bg-amber-500 text-slate-950 text-[11px] font-black">0</span>
              </h2>
              <p class="text-[11px] text-slate-500 mt-0.5">Pendaftar dari Portal Agen menunggu pengecekan NIK &amp; foto KTP sebelum bisa login.</p>
            </div>
          </div>
          <div id="agent-queue-list" class="divide-y divide-slate-100 text-xs">
            <div class="p-6 text-center text-slate-400">Memuat antrean...</div>
          </div>
        </section>

        <section class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
          <div class="lg:col-span-4 bg-white p-6 rounded-2xl border border-slate-200 shadow-xs space-y-4">
            <div>
              <span class="text-[10px] font-extrabold uppercase tracking-wider text-amber-600">Registrasi Otoritas</span>
              <h2 class="text-base font-extrabold text-slate-900">Buat Akun Admin / Agen</h2>
              <p class="text-[11px] text-slate-500 mt-0.5">Tambahkan personel baru ke database Supabase.</p>
            </div>

            <form id="create-user-form" class="space-y-3 text-xs">
              <div>
                <label class="block font-bold text-slate-700 mb-1">Peran (Role) *</label>
                <select id="new-role" class="w-full px-3 py-2 rounded-xl border border-slate-300 bg-white font-bold focus:outline-none focus:ring-2 focus:ring-[#059669]">
                  <option value="ADMIN">ADMIN (Operasional &amp; Verifikasi)</option>
                  <option value="AGENT">AGENT (Mitra Pemasaran Properti)</option>
                  <option value="SUPER_ADMIN">SUPER_ADMIN (Akses Penuh)</option>
                </select>
              </div>
              <div>
                <label class="block font-bold text-slate-700 mb-1">Nama Lengkap *</label>
                <input type="text" id="new-name" required placeholder="Contoh: Admin Cabang Malang" class="w-full px-3 py-2 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-[#059669]" />
              </div>
              <div>
                <label class="block font-bold text-slate-700 mb-1">Username</label>
                <input type="text" id="new-username" placeholder="admin_malang" class="w-full px-3 py-2 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-[#059669]" />
              </div>
              <div>
                <label class="block font-bold text-slate-700 mb-1">Email Login *</label>
                <input type="email" id="new-email" required placeholder="nama@infoproperti.web.id" class="w-full px-3 py-2 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-[#059669]" />
              </div>
              <div>
                <label class="block font-bold text-slate-700 mb-1">No. WhatsApp</label>
                <input type="tel" id="new-phone" placeholder="081234567890" class="w-full px-3 py-2 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-[#059669]" />
              </div>
              <div>
                <label class="block font-bold text-slate-700 mb-1">Kata Sandi Awal *</label>
                <input type="text" id="new-password" required placeholder="Minimal 8 karakter" class="w-full px-3 py-2 rounded-xl border border-slate-300 font-mono focus:outline-none focus:ring-2 focus:ring-[#059669]" />
              </div>
              <button type="submit" id="btn-create-user" class="w-full bg-[#0F172A] hover:bg-slate-800 text-amber-400 font-extrabold py-3 rounded-xl transition cursor-pointer">
                + Simpan Akun ke Database
              </button>
            </form>
          </div>

          <div class="lg:col-span-8 bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden">
            <div class="p-5 border-b border-slate-100 flex flex-wrap items-center justify-between gap-3">
              <div>
                <h2 class="text-base font-extrabold text-slate-900">Daftar Akun Admin, Agen &amp; Pengguna</h2>
                <p class="text-[11px] text-slate-500">Setujui/aktifkan pendaftaran Agen (NIK &amp; KTP), ubah status, atau hapus akun.</p>
              </div>
              <button type="button" id="btn-refresh-users" class="px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-xs font-bold text-slate-700 cursor-pointer">
                Muat Ulang
              </button>
            </div>

            <div class="overflow-x-auto">
              <table class="w-full text-left text-xs">
                <thead class="bg-slate-50 text-slate-500 uppercase text-[10px] font-extrabold border-b border-slate-200">
                  <tr>
                    <th class="px-4 py-3">Pengguna &amp; Identitas</th>
                    <th class="px-4 py-3">Role</th>
                    <th class="px-4 py-3">Status</th>
                    <th class="px-4 py-3 text-right">Aksi Kendali</th>
                  </tr>
                </thead>
                <tbody id="users-tbody" class="divide-y divide-slate-100">
                  <tr>
                    <td colspan="4" class="px-4 py-8 text-center text-slate-400">Memuat data pengguna...</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </section>

        <section class="bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden">
          <div class="p-5 border-b border-slate-100 flex items-center justify-between">
            <div>
              <h2 class="text-base font-extrabold text-slate-900">Monitoring Aktivitas Unit &amp; Pengajuan</h2>
              <p class="text-[11px] text-slate-500">Pantauan cepat aktivitas unit dan pengajuan masuk di sistem.</p>
            </div>
            <a href="/admin" class="text-xs font-bold text-[#059669] hover:underline">Kelola di Panel Admin &rarr;</a>
          </div>
          <div id="recent-orders-list" class="divide-y divide-slate-100 text-xs">
            <div class="p-6 text-center text-slate-400">Memuat data...</div>
          </div>
        </section>
      </main>
    </div>

    <Footer />

    <!-- MODAL FOTO KTP (foto KTP berbentuk data URL tidak bisa dibuka lewat link biasa) -->
    <div id="ktp-modal" class="hidden fixed inset-0 z-50 bg-slate-950/90 flex items-center justify-center p-4">
      <button type="button" id="ktp-close" class="absolute top-5 right-5 text-white bg-slate-800 hover:bg-slate-700 px-3.5 py-2 rounded-lg text-xs font-bold cursor-pointer">
        Tutup &times;
      </button>
      <img id="ktp-img" src="" alt="Foto KTP" class="max-w-full max-h-[85vh] rounded-xl shadow-2xl object-contain bg-white" />
    </div>

    <script is:inline define:vars={{ apiUrl: API_URL }}>
      const API_BASE = apiUrl || '';

      function escapeHtml(str) {
        return String(str == null ? '' : str)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');
      }

      function safeId(id) {
        return String(id == null ? '' : id).replace(/[^a-zA-Z0-9_-]/g, '');
      }

      function clearSession() {
        localStorage.removeItem('lapak_agent');
        localStorage.removeItem('lapak_seller');
        localStorage.removeItem('ip_auth_user');
        localStorage.removeItem('ip_auth_token');
      }

      // Semua request ke API membawa token Bearer; 401 -> kembali ke login super admin
      function authFetch(url, opts) {
        opts = opts || {};
        const headers = Object.assign({}, opts.headers || {});
        try {
          const token = localStorage.getItem('ip_auth_token');
          if (token) headers['Authorization'] = 'Bearer ' + token;
        } catch (e) {}
        opts.headers = headers;

        return fetch(url, opts).then((res) => {
          if (res.status === 401) {
            clearSession();
            window.location.href = '/superadmin/login';
          }
          return res;
        });
      }

      function getSuperAdminSession() {
        try {
          const raw = localStorage.getItem('ip_auth_user');
          if (!raw) return null;
          const parsed = JSON.parse(raw);
          if (!parsed || typeof parsed !== 'object') return null;
          return {
            id: parsed.id || '',
            name: parsed.name || 'Super Admin',
            email: parsed.email || '',
            role: String(parsed.role || '').toUpperCase()
          };
        } catch {
          return null;
        }
      }

      const currentUser = getSuperAdminSession();
      const isAuthorized = Boolean(currentUser && currentUser.role === 'SUPER_ADMIN');

      if (!isAuthorized) {
        window.location.href = '/superadmin/login';
      } else {
        const badgeEl = document.getElementById('sa-user-badge');
        if (badgeEl) {
          badgeEl.textContent = `${currentUser.name} (${currentUser.email})`;
        }
      }

      const usersCache = {};
      const ktpMap = {};

      // ---------- Viewer foto KTP ----------
      const ktpModal = document.getElementById('ktp-modal');
      const ktpImg = document.getElementById('ktp-img');

      window.viewKtp = (id) => {
        const src = ktpMap[id];
        if (!src || !/^(https?:\/\/|data:image\/)/i.test(src)) {
          alert('Foto KTP tidak tersedia atau formatnya tidak valid.');
          return;
        }
        ktpImg.src = src;
        ktpModal.classList.remove('hidden');
      };
      document.getElementById('ktp-close')?.addEventListener('click', () => ktpModal.classList.add('hidden'));
      ktpModal?.addEventListener('click', (e) => {
        if (e.target === ktpModal) ktpModal.classList.add('hidden');
      });

      async function loadDashboardData() {
        if (!isAuthorized) return;
        try {
          const [usersRes, propsRes, ordersRes] = await Promise.all([
            authFetch(`${API_BASE}/api/superadmin/users`, { cache: 'no-store' }),
            fetch(`${API_BASE}/api/properties`, { cache: 'no-store' }),
            authFetch(`${API_BASE}/api/admin/orders`, { cache: 'no-store' })
          ]);

          const users = usersRes.ok ? await usersRes.json().catch(() => []) : [];
          const props = propsRes.ok ? await propsRes.json().catch(() => []) : [];
          const orders = ordersRes.ok ? await ordersRes.json().catch(() => []) : [];

          document.getElementById('stat-props').textContent = String(Array.isArray(props) ? props.length : 0);
          const bookedCount = Array.isArray(props)
            ? props.filter((p) => ['BOOKED', 'SOLD'].includes(String(p.status).toUpperCase())).length
            : 0;
          document.getElementById('stat-booked').textContent = `${bookedCount} unit terkunci`;

          document.getElementById('stat-orders').textContent = String(Array.isArray(orders) ? orders.length : 0);
          const pendingCount = Array.isArray(orders)
            ? orders.filter((o) => o.status === 'PENDING_VERIFICATION').length
            : 0;
          document.getElementById('stat-pending').textContent = `${pendingCount} menunggu verifikasi`;

          const safeUsers = Array.isArray(users) ? users : [];
          const adminCount = safeUsers.filter((u) => u.role === 'ADMIN').length;
          const agents = safeUsers.filter((u) => u.role === 'AGENT');
          const pendingAgents = agents.filter((a) => a.is_active === false).length;

          document.getElementById('stat-admins').textContent = String(adminCount);
          document.getElementById('stat-agents').textContent = String(agents.length);
          document.getElementById('stat-agents-pending').textContent = `${pendingAgents} menunggu aktif`;

          renderUsersTable(safeUsers);
          renderAgentQueue(safeUsers);
          renderRecentOrders(Array.isArray(orders) ? orders.slice(0, 5) : []);
        } catch (err) {
          console.error('Gagal memuat dashboard Super Admin:', err);
        }
      }

      function renderUsersTable(users) {
        const tbody = document.getElementById('users-tbody');
        if (!Array.isArray(users) || !users.length) {
          tbody.innerHTML = `<tr><td colspan="4" class="px-4 py-8 text-center text-slate-400">Belum ada akun tersimpan di tabel users. Gunakan formulir di samping untuk menambahkan.</td></tr>`;
          return;
        }

        tbody.innerHTML = users.map((u) => {
          const uid = safeId(u.id);
          usersCache[uid] = u;
          const role = String(u.role || 'BUYER').toUpperCase();
          const roleBadge = role === 'SUPER_ADMIN'
            ? 'bg-amber-100 text-amber-800'
            : role === 'ADMIN'
            ? 'bg-indigo-100 text-indigo-800'
            : role === 'AGENT'
            ? 'bg-emerald-100 text-emerald-800'
            : 'bg-slate-100 text-slate-700';

          const isActive = u.is_active !== false;
          const nikInfo = u.nik ? ` • NIK: <span class="font-mono">${escapeHtml(u.nik)}</span>` : '';

          let ktpLink = '';
          if (u.ktp_image_url && /^(https?:\/\/|data:image\/)/i.test(String(u.ktp_image_url).trim())) {
            ktpMap[uid] = String(u.ktp_image_url).trim();
            ktpLink = ` • <button type="button" onclick="viewKtp('${uid}')" class="text-emerald-700 font-bold underline cursor-pointer">Lihat KTP</button>`;
          }

          return `
            <tr class="hover:bg-slate-50/80">
              <td class="px-4 py-3.5">
                <strong class="block text-slate-900">${escapeHtml(u.name || '-')}</strong>
                <span class="text-[11px] text-slate-500">${escapeHtml(u.email || '-')} ${u.phone ? `• ${escapeHtml(u.phone)}` : ''}${nikInfo}${ktpLink}</span>
              </td>
              <td class="px-4 py-3.5">
                <span class="px-2.5 py-0.5 rounded-md text-[10px] font-extrabold ${roleBadge}">${escapeHtml(role)}</span>
              </td>
              <td class="px-4 py-3.5">
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold ${isActive ? 'bg-emerald-50 text-emerald-700' : 'bg-amber-50 text-amber-800'}">
                  ${isActive ? 'AKTIF' : 'MENUNGGU / NONAKTIF'}
                </span>
              </td>
              <td class="px-4 py-3.5 text-right space-x-1.5">
                <button
                  type="button"
                  onclick="toggleUserStatus('${uid}', ${!isActive})"
                  class="px-2.5 py-1 rounded-lg border border-slate-200 hover:bg-slate-100 text-[11px] font-bold text-slate-700 cursor-pointer"
                >
                  ${isActive ? 'Nonaktifkan' : 'Setujui & Aktifkan'}
                </button>
                <button
                  type="button"
                  onclick="deleteUser('${uid}')"
                  class="px-2.5 py-1 rounded-lg bg-rose-50 hover:bg-rose-100 text-[11px] font-bold text-rose-700 cursor-pointer"
                >
                  Hapus
                </button>
              </td>
            </tr>
          `;
        }).join('');
      }

      function renderAgentQueue(users) {
        const box = document.getElementById('agent-queue-list');
        const countEl = document.getElementById('agent-queue-count');
        const pending = (Array.isArray(users) ? users : []).filter(
          (u) => String(u.role || '').toUpperCase() === 'AGENT' && u.is_active === false
        );
        if (countEl) countEl.textContent = String(pending.length);
        if (!box) return;

        if (!pending.length) {
          box.innerHTML = `<div class="p-6 text-center text-slate-400">Tidak ada pendaftaran agen yang menunggu verifikasi.</div>`;
          return;
        }

        box.innerHTML = pending.map((u) => {
          const uid = safeId(u.id);
          usersCache[uid] = u;

          let ktpBtn = `<span class="text-[11px] text-slate-400">Tanpa foto KTP</span>`;
          if (u.ktp_image_url && /^(https?:\/\/|data:image\/)/i.test(String(u.ktp_image_url).trim())) {
            ktpMap[uid] = String(u.ktp_image_url).trim();
            ktpBtn = `<button type="button" onclick="viewKtp('${uid}')" class="px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold cursor-pointer">Lihat KTP</button>`;
          }

          const nikValid = /^\d{16}$/.test(String(u.nik || ''));
          const dateTxt = u.created_at
            ? new Date(u.created_at).toLocaleString('id-ID', { dateStyle: 'medium', timeStyle: 'short' })
            : '-';

          return `
            <div class="p-4 sm:p-5 flex flex-col lg:flex-row lg:items-center justify-between gap-4 hover:bg-slate-50/70">
              <div class="space-y-1">
                <strong class="text-sm font-extrabold text-slate-900">${escapeHtml(u.name || '-')}</strong>
                <p class="text-[11px] text-slate-600">${escapeHtml(u.email || '-')} • WA: ${escapeHtml(u.phone || '-')}</p>
                <p class="text-[11px] text-slate-600">
                  NIK: <span class="font-mono">${escapeHtml(u.nik || '-')}</span>
                  ${nikValid ? '' : '<span class="text-rose-600 font-bold">(format NIK tidak valid)</span>'}
                  • Daftar: ${escapeHtml(dateTxt)}
                </p>
              </div>
              <div class="flex flex-wrap items-center gap-2 shrink-0">
                ${ktpBtn}
                <button type="button" onclick="toggleUserStatus('${uid}', true)" class="px-3 py-1.5 rounded-lg bg-[#059669] hover:bg-emerald-700 text-white font-bold cursor-pointer">Setujui &amp; Aktifkan</button>
                <button type="button" onclick="deleteUser('${uid}')" class="px-3 py-1.5 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-700 font-bold cursor-pointer">Tolak &amp; Hapus</button>
              </div>
            </div>
          `;
        }).join('');
      }

      function renderRecentOrders(orders) {
        const box = document.getElementById('recent-orders-list');
        if (!Array.isArray(orders) || !orders.length) {
          box.innerHTML = `<div class="p-6 text-center text-slate-400">Belum ada data pengajuan.</div>`;
          return;
        }
        box.innerHTML = orders.map((o) => `
          <div class="p-4 px-5 flex flex-wrap items-center justify-between gap-2">
            <div>
              <strong class="text-slate-900">${escapeHtml(o.properties?.title || 'Unit Properti')}</strong>
              <span class="block text-[11px] text-slate-500">Pemesan: ${escapeHtml(o.buyer_name)} (${escapeHtml(o.buyer_phone)})</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="px-2.5 py-0.5 rounded-full text-[10px] font-extrabold bg-slate-100 text-slate-700">${escapeHtml(o.status)}</span>
            </div>
          </div>
        `).join('');
      }

      function showApprovedNotice(user) {
        const old = document.getElementById('approved-notice');
        if (old) old.remove();
        const list = document.getElementById('agent-queue-list');
        if (!list || !user) return;
        let phone = String(user.phone || '').replace(/\D/g, '');
        if (phone.startsWith('0')) phone = '62' + phone.slice(1);
        const msg = `Halo ${user.name || ''}, pendaftaran agen Anda di InfoProperti sudah disetujui dan akun sudah aktif. Silakan masuk di ${location.origin}/agen/login menggunakan email dan password saat mendaftar. Terima kasih.`;
        const waHref = phone ? `https://wa.me/${phone}?text=${encodeURIComponent(msg)}` : '';
        const box = document.createElement('div');
        box.id = 'approved-notice';
        box.className = 'p-4 bg-emerald-50 border-b border-emerald-200 flex flex-wrap items-center justify-between gap-3 text-xs';
        box.innerHTML = `
          <span class="text-emerald-900 font-semibold">Akun ${escapeHtml(user.name || 'agen')} sudah aktif. Kabari agen agar tahu sudah bisa masuk.</span>
          ${waHref ? `<a href="${waHref}" target="_blank" rel="noopener noreferrer" class="px-3 py-1.5 rounded-lg bg-[#059669] hover:bg-emerald-700 text-white font-bold">Kabari via WhatsApp</a>` : '<span class="text-rose-700 font-bold">Nomor WA tidak tersedia</span>'}
        `;
        list.parentNode.insertBefore(box, list);
      }

      window.toggleUserStatus = async (id, nextActive) => {
        const target = usersCache[id];
        const wasPendingAgent = !!(target && String(target.role || '').toUpperCase() === 'AGENT' && target.is_active === false);
        const res = await authFetch(`${API_BASE}/api/superadmin/users/${encodeURIComponent(id)}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ is_active: nextActive })
        });
        if (res.ok) {
          await loadDashboardData();
          if (nextActive && wasPendingAgent) showApprovedNotice(target);
        } else {
          const data = await res.json().catch(() => ({}));
          alert(data.error || 'Gagal mengubah status akun.');
        }
      };

      window.deleteUser = async (id) => {
        const name = (usersCache[id] && usersCache[id].name) || 'ini';
        if (!confirm(`Hapus permanen akun ${name}?`)) return;
        const res = await authFetch(`${API_BASE}/api/superadmin/users/${encodeURIComponent(id)}`, { method: 'DELETE' });
        if (res.ok) {
          loadDashboardData();
        } else {
          const data = await res.json().catch(() => ({}));
          alert(data.error || 'Gagal menghapus akun.');
        }
      };

      document.getElementById('create-user-form')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = document.getElementById('btn-create-user');
        btn.disabled = true;
        btn.textContent = 'Menyimpan...';

        try {
          const res = await authFetch(`${API_BASE}/api/superadmin/users`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              role: document.getElementById('new-role').value,
              name: document.getElementById('new-name').value.trim(),
              username: document.getElementById('new-username').value.trim() || undefined,
              email: document.getElementById('new-email').value.trim(),
              phone: document.getElementById('new-phone').value.trim(),
              password: document.getElementById('new-password').value
            })
          });
          const data = await res.json().catch(() => ({}));
          if (res.ok) {
            alert(data.message || 'Akun berhasil dibuat!');
            e.target.reset();
            loadDashboardData();
          } else {
            alert(data.error || 'Gagal membuat akun.');
          }
        } catch {
          alert('Gagal terhubung ke server.');
        } finally {
          btn.disabled = false;
          btn.textContent = '+ Simpan Akun ke Database';
        }
      });

      document.getElementById('btn-sync-sheets')?.addEventListener('click', async () => {
        const res = await authFetch(`${API_BASE}/api/admin/sync-sheets`, { method: 'POST' });
        const data = await res.json().catch(() => ({}));
        alert(data.message || data.error || 'Sinkronisasi selesai.');
      });

      document.getElementById('btn-refresh-users')?.addEventListener('click', loadDashboardData);
      loadDashboardData();
    </script>
  </body>
</html>