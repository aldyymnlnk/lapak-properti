---
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const API_URL = (import.meta as any).env?.PUBLIC_API_URL || 'http://localhost:5000';
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login Super Admin — InfoProperti</title>
    <meta name="robots" content="noindex, nofollow" />
    <style is:global>
      @import '../../styles/global.css';
    </style>
  </head>
  <body class="bg-slate-50 text-slate-900 font-sans min-h-screen flex flex-col justify-between">
    <div>
      <Navbar active="superadmin" />

      <main class="max-w-md mx-auto px-4 py-14">
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
          <div class="bg-[#0F172A] text-white p-6 text-center">
            <span class="inline-block px-3 py-1 rounded-full bg-amber-500 text-slate-950 text-[10px] font-black uppercase tracking-wider mb-2">
              SUPER ADMIN LOGIN
            </span>
            <h1 class="text-xl font-extrabold">Masuk Pusat Kendali</h1>
            <p class="text-xs text-slate-300 mt-1">
              Khusus otoritas Super Admin InfoProperti.
            </p>
          </div>

          <div class="p-6 space-y-5">
            <div id="sa-login-alert" class="hidden p-3 rounded-xl text-xs font-semibold"></div>

            <form id="sa-login-form" class="space-y-4 text-xs">
              <div>
                <label class="block font-bold text-slate-700 mb-1">Email atau Username Super Admin</label>
                <input
                  type="text"
                  id="sa-identifier"
                  required
                  placeholder="superadmin@infoproperti.web.id"
                  class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-[#059669]"
                />
              </div>

              <div>
                <label class="block font-bold text-slate-700 mb-1">Kata Sandi</label>
                <input
                  type="password"
                  id="sa-password"
                  required
                  placeholder="Masukkan kata sandi"
                  class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-[#059669]"
                />
              </div>

              <div>
                <label class="block font-bold text-slate-700 mb-1">Kode Akses (Opsional)</label>
                <input
                  type="password"
                  id="sa-code"
                  placeholder="Kosongkan jika pakai email & sandi"
                  class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 font-mono focus:outline-none focus:ring-2 focus:ring-[#059669]"
                />
              </div>

              <button
                type="submit"
                id="btn-sa-login"
                class="w-full bg-[#0F172A] hover:bg-slate-800 text-amber-400 font-extrabold text-sm py-3 rounded-xl shadow-xs transition cursor-pointer"
              >
                Masuk ke Super Admin
              </button>
            </form>

            <div class="text-center pt-3 border-t border-slate-100 text-xs">
              <a href="/masuk" class="font-bold text-[#059669] hover:underline">
                Masuk sebagai Admin / Agen / Pembeli &rarr;
              </a>
            </div>
          </div>
        </div>
      </main>
    </div>

    <Footer />

    <script is:inline define:vars={{ apiUrl: API_URL }}>
      const API_BASE = apiUrl || 'http://localhost:5000';
      const alertBox = document.getElementById('sa-login-alert');

      function showAlert(msg, isErr = true) {
        alertBox.textContent = msg;
        alertBox.className = `p-3 rounded-xl text-xs font-semibold ${
          isErr ? 'bg-rose-50 text-rose-700 border border-rose-200' : 'bg-emerald-50 text-emerald-700 border border-emerald-200'
        }`;
        alertBox.classList.remove('hidden');
      }

      document.getElementById('sa-login-form')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const identifier = document.getElementById('sa-identifier').value.trim();
        const password = document.getElementById('sa-password').value;
        const accessCode = document.getElementById('sa-code').value.trim();
        const btn = document.getElementById('btn-sa-login');
        btn.disabled = true;
        btn.textContent = 'Memverifikasi...';

        try {
          const res = await fetch(`${API_BASE}/api/auth/login`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              email: identifier.includes('@') ? identifier : undefined,
              username: !identifier.includes('@') ? identifier : undefined,
              password,
              access_code: accessCode || undefined
            })
          });
          const data = await res.json();

          if (!res.ok || !data.user) {
            showAlert(data.error || 'Kredensial Super Admin tidak valid.');
            btn.disabled = false;
            btn.textContent = 'Masuk ke Super Admin';
            return;
          }

          if (String(data.user.role || '').toUpperCase() !== 'SUPER_ADMIN') {
            showAlert('Akun ini bukan SUPER_ADMIN. Silakan gunakan halaman Masuk utama.');
            btn.disabled = false;
            btn.textContent = 'Masuk ke Super Admin';
            return;
          }

          localStorage.setItem('ip_auth_user', JSON.stringify(data.user));
          showAlert('Login Super Admin berhasil! Mengalihkan...', false);
          setTimeout(() => {
            window.location.href = '/superadmin';
          }, 400);
        } catch {
          showAlert('Gagal terhubung ke server.');
          btn.disabled = false;
          btn.textContent = 'Masuk ke Super Admin';
        }
      });
    </script>
  </body>
</html>