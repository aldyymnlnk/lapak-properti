---
export const prerender = false;
import { getAllProperties } from '../../lib/properties';
import PropertyCms from '../../components/PropertyCms.astro';

const API_URL = (import.meta as any).env?.PUBLIC_API_URL || '';

const properties: any[] = await getAllProperties(Astro.locals);
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CMS Kelola Katalog Properti — InfoProperti</title>
    <meta name="robots" content="noindex, nofollow" />
    <style is:global>
      @import '../../styles/global.css';
    </style>
  </head>
  <body class="bg-slate-100 text-slate-900 font-sans min-h-screen flex flex-col justify-between">

    <div>
      <!-- HEADER ADMIN CMS -->
      <header class="bg-[#0F172A] text-white py-4 shadow-md sticky top-0 z-50">
        <div class="max-w-6xl mx-auto px-4 flex flex-wrap justify-between items-center gap-3">
          <div class="flex items-center gap-3">
            <a href="/admin" class="w-9 h-9 bg-[#059669] rounded-lg flex items-center justify-center font-extrabold text-white text-lg tracking-wider">
              IP
            </a>
            <div>
              <h1 class="text-base font-bold tracking-tight leading-none">CMS Dashboard Admin</h1>
              <span id="cms-user-badge" class="text-[10px] text-slate-400">Manajemen Katalog & Stok Properti</span>
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-2 text-xs font-semibold">
            <a href="/admin" class="bg-slate-800 hover:bg-slate-700 text-slate-200 px-3 py-1.5 rounded-lg border border-slate-700 transition">
              Dashboard & Verifikasi
            </a>
            <a href="/admin/properties" class="bg-slate-800 text-emerald-400 px-3 py-1.5 rounded-lg border border-slate-700">
              Kelola Katalog Properti
            </a>
            <a href="/katalog" target="_blank" rel="noopener noreferrer" class="bg-emerald-600/20 hover:bg-emerald-600/30 text-emerald-300 px-3 py-1.5 rounded-lg border border-emerald-500/30 transition">
              Lihat Katalog
            </a>
            <button
              type="button"
              id="btn-cms-logout"
              class="bg-rose-600 hover:bg-rose-700 text-white px-3 py-1.5 rounded-lg transition cursor-pointer"
            >
              Keluar
            </button>
          </div>
        </div>
      </header>

      <PropertyCms properties={properties} apiUrl={API_URL} loginHref="/admin/login" />
    </div>

    <footer class="bg-white border-t border-slate-200 py-6 text-center text-xs text-slate-500">
      <p>© 2026 InfoProperti Admin CMS Portal.</p>
    </footer>


  </body>
</html>