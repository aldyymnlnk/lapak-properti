---
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const API_URL = (import.meta as any).env?.PUBLIC_API_URL || '';
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login Admin — InfoProperti</title>
    <meta name="robots" content="noindex, nofollow" />
    <style is:global>
      @import '../../styles/global.css';
    </style>
  </head>
  <body class="bg-slate-50 text-slate-900 font-sans min-h-screen flex flex-col justify-between">
    <div>
      <Navbar active="admin" />

      <main class="max-w-md mx-auto px-4 py-14">
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
          <div class="bg-[#0F172A] text-white p-6 text-center">
            <span class="inline-block px-3 py-1 rounded-full bg-emerald-500 text-slate-950 text-[10px] font-black uppercase tracking-wider mb-2">
              ADMIN OPERASIONAL
            </span>
            <h1 class="text-xl font-extrabold">Masuk Panel Admin</h1>
            <p class="text-xs text-slate-300 mt-1">
              Khusus admin operasional InfoProperti.
            </p>
          </div>

          <div class="p-6 space-y-5">
            <div id="adm-login-alert" class="hidden p-3 rounded-xl text-xs font-semibold"></div>

            <form id="adm-login-form" class="space-y-4 text-xs">
              <div>
                <label class="block font-bold text-slate-700 mb-1">Email atau Username Admin</label>
                <input
                  type="text"
                  id="adm-identifier"
                  autocomplete="off"
                  placeholder="admin@infoproperti.web.id"
                  class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-[#059669]"
                />
              </div>

              <div>
                <label class="block font-bold text-slate-700 mb-1">Kata Sandi</label>
                <input
                  type="password"
                  id="adm-password"
                  placeholder="Masukkan kata sandi"
                  class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-[#059669]"
                />
              </div>

              <div class="flex items-center gap-3 text-[11px] text-slate-400">
                <span class="flex-1 h-px bg-slate-200"></span>
                <span>ATAU</span>
                <span class="flex-1 h-px bg-slate-200"></span>
              </div>

              <div>
                <label class="block font-bold text-slate-700 mb-1">Kode Akses</label>
                <input
                  type="password"
                  id="adm-code"
                  autocomplete="off"
                  placeholder="Isi kode akses (tanpa email & sandi)"
                  class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 font-mono focus:outline-none focus:ring-2 focus:ring-[#059669]"
                />
              </div>

              <button
                type="submit"
                id="btn-adm-login"
                class="w-full bg-[#059669] hover:bg-emerald-700 text-white font-extrabold text-sm py-3 rounded-xl shadow-xs transition cursor-pointer"
              >
                Masuk ke Panel Admin
              </button>
            </form>

            <div class="text-center pt-3 border-t border-slate-100 text-xs space-y-1.5">
              <p>
                <a href="/agen/login" class="font-bold text-slate-700 hover:text-[#059669] hover:underline">Portal Agen &rarr;</a>
              </p>
              <p>
                <a href="/superadmin/login" class="font-bold text-slate-700 hover:text-[#059669] hover:underline">Login Super Admin &rarr;</a>
              </p>
            </div>
          </div>
        </div>
      </main>
    </div>

    <Footer />

    <script is:inline define:vars={{ apiUrl: API_URL }}>
      const API_BASE = apiUrl || '';
      const alertBox = document.getElementById('adm-login-alert');
      const btn = document.getElementById('btn-adm-login');

      function showAlert(msg, isErr = true) {
        alertBox.textContent = msg;
        alertBox.className = `p-3 rounded-xl text-xs font-semibold ${
          isErr ? 'bg-rose-50 text-rose-700 border border-rose-200' : 'bg-emerald-50 text-emerald-700 border border-emerald-200'
        }`;
        alertBox.classList.remove('hidden');
      }

      function resetBtn() {
        btn.disabled = false;
        btn.textContent = 'Masuk ke Panel Admin';
      }

      document.getElementById('adm-login-form')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const identifier = document.getElementById('adm-identifier').value.trim();
        const password = document.getElementById('adm-password').value;
        const accessCode = document.getElementById('adm-code').value.trim();

        if (!accessCode && (!identifier || !password)) {
          showAlert('Isi email/username dan kata sandi, atau isi Kode Akses.');
          return;
        }

        btn.disabled = true;
        btn.textContent = 'Memverifikasi...';

        const payload = accessCode
          ? { access_code: accessCode }
          : {
              email: identifier.includes('@') ? identifier : undefined,
              username: !identifier.includes('@') ? identifier : undefined,
              password
            };

        try {
          const res = await fetch(`${API_BASE}/api/auth/login`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          const data = await res.json().catch(() => ({}));

          if (!res.ok || !data.user) {
            showAlert(data.error || 'Kredensial admin tidak valid.');
            resetBtn();
            return;
          }

          const role = String(data.user.role || '').toUpperCase();
          const allowed = ['ADMIN', 'SELLER', 'SUPER_ADMIN'];
          if (!allowed.includes(role)) {
            showAlert(
              'Akun ini terdaftar sebagai "' + (role || 'BUYER') + '", bukan Admin. ' +
                (role === 'AGENT' ? 'Gunakan Portal Agen.' : 'Gunakan halaman Masuk yang sesuai.')
            );
            resetBtn();
            return;
          }

          const sessionUser = { ...data.user, role };
          localStorage.removeItem('lapak_agent');
          localStorage.removeItem('lapak_seller');
          localStorage.removeItem('ip_auth_token');
          localStorage.setItem('ip_auth_user', JSON.stringify(sessionUser));
          if (data.token) localStorage.setItem('ip_auth_token', data.token);
          if (role !== 'SUPER_ADMIN') {
            localStorage.setItem('lapak_seller', JSON.stringify(sessionUser));
          }

          showAlert('Login berhasil! Mengalihkan...', false);
          setTimeout(() => {
            window.location.href = role === 'SUPER_ADMIN' ? '/superadmin' : '/admin';
          }, 400);
        } catch {
          showAlert('Gagal terhubung ke server.');
          resetBtn();
        }
      });
    </script>
  </body>
</html>