---
export const prerender = false;

const API_URL = (import.meta as any).env?.PUBLIC_API_URL || 'http://localhost:5000';

let orders: any[] = [];
let properties: any[] = [];
let agents: any[] = [];

try {
  const [ordersRes, propsRes, agentsRes] = await Promise.all([
    fetch(`${API_URL}/api/admin/orders`, { cache: 'no-store' }),
    fetch(`${API_URL}/api/properties`, { cache: 'no-store' }),
    fetch(`${API_URL}/api/admin/agents`, { cache: 'no-store' })
  ]);

  if (ordersRes.ok) orders = await ordersRes.json();
  if (propsRes.ok) properties = await propsRes.json();
  if (agentsRes.ok) agents = await agentsRes.json();
} catch {
  orders = [];
  properties = [];
  agents = [];
}

const pendingCount = orders.filter((o: any) => o.status === 'PENDING_VERIFICATION').length;
const paidOrders = orders.filter((o: any) => o.status === 'PAID');
const totalRevenue = paidOrders.reduce((sum: number, o: any) => sum + Number(o.properties?.price || 0), 0);
const availableProps = properties.filter((p: any) => String(p.status || 'available').toLowerCase() === 'available').length;
const bookedProps = properties.filter((p: any) => {
  const st = String(p.status || '').toLowerCase();
  return st === 'booked' || st === 'sold';
}).length;
const activeAgentsCount = agents.filter((a: any) => a.is_active !== false).length;
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin CMS Dashboard — LapakProperti</title>
    <style is:global>
      @import '../../styles/global.css';
    </style>
  </head>
  <body class="bg-slate-100 text-slate-900 font-sans min-h-screen flex flex-col md:flex-row">

    <!-- TOAST NOTIFIKASI PROFESIONAL -->
    <div
      id="admin-toast-container"
      aria-live="polite"
      class="fixed top-4 right-4 z-[9999] flex flex-col gap-2.5 max-w-sm w-[calc(100vw-2rem)] pointer-events-none"
    ></div>

    <!-- ================= SIDEBAR NAVIGASI KIRI ================= -->
    <aside class="w-full md:w-64 bg-[#0F172A] text-white flex flex-col justify-between shrink-0 md:min-h-screen sticky top-0 z-40">
      <div>
        <div class="p-5 border-b border-slate-800 flex items-center justify-between">
          <a href="/admin" class="flex items-center gap-3">
            <span class="w-9 h-9 bg-[#059669] rounded-xl flex items-center justify-center font-black text-white text-base shadow-sm">
              LP
            </span>
            <div>
              <h1 class="text-sm font-extrabold tracking-tight leading-none">LapakProperti</h1>
              <span class="text-[10px] text-emerald-400 font-semibold">Admin Control Panel</span>
            </div>
          </a>
        </div>

        <!-- Info Akun Login -->
        <div class="px-4 py-3 mx-3 mt-3 rounded-xl bg-slate-800/70 border border-slate-700/80 text-xs">
          <span class="text-[10px] text-slate-400 block">Login sebagai:</span>
          <strong id="sidebar-admin-name" class="text-white font-bold block truncate">Administrator</strong>
          <span id="sidebar-admin-email" class="text-[10px] text-emerald-400 block truncate">admin@lapakproperti.id</span>
        </div>

        <nav class="p-3 flex md:flex-col gap-1.5 overflow-x-auto text-xs font-semibold">
          <button
            type="button"
            data-target="tab-stats"
            class="sidebar-btn flex items-center gap-2.5 px-3.5 py-2.5 rounded-xl bg-emerald-600 text-white transition whitespace-nowrap cursor-pointer text-left"
          >
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
            <span>Statistik & Ringkasan</span>
          </button>

          <button
            type="button"
            data-target="tab-properties"
            class="sidebar-btn flex items-center gap-2.5 px-3.5 py-2.5 rounded-xl text-slate-300 hover:bg-slate-800 hover:text-white transition whitespace-nowrap cursor-pointer text-left"
          >
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
            <span>Kelola & Posting Properti</span>
          </button>

          <button
            type="button"
            data-target="tab-orders"
            class="sidebar-btn flex items-center justify-between gap-2.5 px-3.5 py-2.5 rounded-xl text-slate-300 hover:bg-slate-800 hover:text-white transition whitespace-nowrap cursor-pointer text-left"
          >
            <span class="flex items-center gap-2.5">
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
              </svg>
              <span>Log Pengajuan & ACC</span>
            </span>
            {pendingCount > 0 && (
              <span class="px-2 py-0.5 text-[10px] font-black rounded-full bg-amber-500 text-slate-950">
                {pendingCount}
              </span>
            )}
          </button>

          <button
            type="button"
            data-target="tab-agents"
            class="sidebar-btn flex items-center justify-between gap-2.5 px-3.5 py-2.5 rounded-xl text-slate-300 hover:bg-slate-800 hover:text-white transition whitespace-nowrap cursor-pointer text-left"
          >
            <span class="flex items-center gap-2.5">
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <span>Portal & Akun Agen</span>
            </span>
            <span class="px-2 py-0.5 text-[10px] font-bold rounded-full bg-slate-700 text-emerald-300">
              {agents.length}
            </span>
          </button>
        </nav>
      </div>

      <div class="p-4 border-t border-slate-800 hidden md:flex flex-col gap-2 text-xs">
        <a
          href="/katalog"
          target="_blank"
          class="w-full inline-flex items-center justify-center gap-1.5 py-2 px-3 rounded-xl bg-emerald-600/20 hover:bg-emerald-600/30 text-emerald-300 border border-emerald-500/30 font-semibold transition"
        >
          <span>Lihat Katalog Publik</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
        <a
          href="/"
          target="_blank"
          class="w-full inline-flex items-center justify-center gap-1.5 py-2 px-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold transition"
        >
          <span>Lihat Website Pembeli</span>
        </a>
        <button
          type="button"
          onclick="window.logoutAdmin()"
          class="w-full inline-flex items-center justify-center gap-1.5 py-2 px-3 rounded-xl bg-rose-600/90 hover:bg-rose-600 text-white font-bold transition cursor-pointer"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
          </svg>
          <span>Logout Admin</span>
        </button>
      </div>
    </aside>

    <!-- ================= AREA KONTEN UTAMA KANAN ================= -->
    <div class="flex-1 flex flex-col min-w-0">

      <header class="bg-white border-b border-slate-200 px-6 py-4 flex items-center justify-between">
        <div>
          <h2 id="page-heading" class="text-base sm:text-lg font-extrabold text-slate-900">Statistik & Ringkasan Bisnis</h2>
          <p class="text-xs text-slate-500">Kontrol penuh seluruh listing Kos, Rumah, Kavling Tanah, verifikasi KTP, dan agen mitra.</p>
        </div>
        <div class="flex items-center gap-2">
          <button
            onclick="window.location.reload()"
            class="inline-flex items-center gap-1.5 text-xs bg-slate-100 hover:bg-slate-200 text-slate-700 px-3 py-1.5 rounded-lg border border-slate-200 font-semibold transition cursor-pointer"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            <span>Refresh</span>
          </button>
          <button
            type="button"
            onclick="window.logoutAdmin()"
            class="md:hidden text-xs bg-rose-600 text-white px-3 py-1.5 rounded-lg font-bold"
          >
            Logout
          </button>
        </div>
      </header>

      <main class="p-4 sm:p-6 lg:p-8 flex-1 space-y-8">

        <!-- ========================================================= -->
        <!-- MENU 1: STATISTIK & RINGKASAN                             -->
        <!-- ========================================================= -->
        <section id="tab-stats" class="tab-panel space-y-6">
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
            <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-xs">
              <span class="text-xs font-semibold text-slate-500">Total Unit Terdaftar</span>
              <h3 class="text-2xl font-black text-slate-900 mt-1">{properties.length} <span class="text-xs font-normal text-slate-400">Unit</span></h3>
              <span class="text-[11px] text-emerald-600 mt-1 block">Kos, Rumah & Kavling Tanah</span>
            </div>

            <div class="bg-white p-5 rounded-2xl border border-emerald-200 shadow-xs">
              <span class="text-xs font-semibold text-emerald-700">Unit Tersedia</span>
              <h3 class="text-2xl font-black text-emerald-700 mt-1">{availableProps}</h3>
              <span class="text-[11px] text-emerald-600/80 mt-1 block">Status AVAILABLE</span>
            </div>

            <div class="bg-white p-5 rounded-2xl border border-rose-200 shadow-xs">
              <span class="text-xs font-semibold text-rose-700">Unit Terkunci</span>
              <h3 class="text-2xl font-black text-rose-600 mt-1">{bookedProps}</h3>
              <span class="text-[11px] text-rose-600/80 mt-1 block">Status BOOKED / SOLD</span>
            </div>

            <div class="bg-white p-5 rounded-2xl border border-indigo-200 shadow-xs">
              <span class="text-xs font-semibold text-indigo-700">Mitra Agen Aktif</span>
              <h3 class="text-2xl font-black text-indigo-700 mt-1">{activeAgentsCount} <span class="text-xs font-normal text-indigo-400">/ {agents.length}</span></h3>
              <span class="text-[11px] text-indigo-600/80 mt-1 block">Terdaftar di Supabase</span>
            </div>

            <div class="bg-white p-5 rounded-2xl border border-blue-200 shadow-xs">
              <span class="text-xs font-semibold text-blue-700">Total Transaksi Lunas</span>
              <h3 class="text-lg font-black text-blue-700 mt-1">Rp {totalRevenue.toLocaleString('id-ID')}</h3>
              <span class="text-[11px] text-blue-600/80 mt-1 block">{paidOrders.length} transaksi PAID</span>
            </div>
          </div>

          <div class="bg-white rounded-2xl border border-slate-200 p-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div>
              <h3 class="text-sm font-extrabold text-slate-800">Pintasan Pengelolaan Cepat</h3>
              <p class="text-xs text-slate-500 mt-0.5">Tambah unit properti baru, verifikasi KTP pembeli, kelola akun agen, atau sinkronkan laporan.</p>
            </div>
            <div class="flex flex-wrap gap-2">
              <button
                type="button"
                onclick="window.switchSidebarTab('tab-properties')"
                class="inline-flex items-center gap-1.5 bg-[#059669] hover:bg-emerald-700 text-white text-xs font-bold px-4 py-2.5 rounded-xl transition cursor-pointer"
              >
                <span>+ Posting Unit Baru</span>
              </button>

              <button
                type="button"
                onclick="window.switchSidebarTab('tab-orders')"
                class="inline-flex items-center gap-1.5 bg-amber-500 hover:bg-amber-600 text-slate-950 text-xs font-extrabold px-4 py-2.5 rounded-xl transition cursor-pointer"
              >
                <span>Verifikasi & Order ({orders.length})</span>
              </button>

              <button
                type="button"
                onclick="window.switchSidebarTab('tab-agents')"
                class="inline-flex items-center gap-1.5 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold px-4 py-2.5 rounded-xl transition cursor-pointer"
              >
                <span>Kelola Agen ({agents.length})</span>
              </button>

              <button
                type="button"
                onclick="window.syncAllToGoogleSheets()"
                class="inline-flex items-center gap-1.5 bg-[#0F172A] hover:bg-slate-800 text-emerald-400 text-xs font-bold px-4 py-2.5 rounded-xl transition cursor-pointer"
              >
                <span>Sync ke Google Sheets</span>
              </button>
            </div>
          </div>
        </section>

        <!-- ========================================================= -->
        <!-- MENU 2: EDIT & POSTING PROPERTI DINAMIS SESUAI KATEGORI   -->
        <!-- ========================================================= -->
        <section id="tab-properties" class="tab-panel hidden space-y-6">

          <div class="bg-white rounded-2xl shadow-xs border border-slate-200 p-6">
            <div class="flex items-center justify-between border-b border-slate-100 pb-4 mb-5">
              <div>
                <h3 id="form-prop-heading" class="text-base font-extrabold text-slate-900">Posting Properti Baru ke Katalog</h3>
                <p class="text-xs text-slate-500">Pilih kategori hunian, unggah minimal 1 foto sampul, dan tambahkan foto pendukung sesuai unit asli.</p>
              </div>
              <button
                type="button"
                id="btn-cancel-edit"
                class="hidden inline-flex items-center gap-1 text-xs font-bold text-rose-600 hover:underline cursor-pointer"
              >
                <span>Batal Edit ✕</span>
              </button>
            </div>

            <form id="cms-property-form" class="grid grid-cols-1 lg:grid-cols-3 gap-6 text-xs">
              <input type="hidden" id="prop-id" value="" />
              <input type="hidden" id="prop-agent-id" value="" />
              <input type="hidden" id="prop-agent-email" value="" />

              <!-- Kolom Input Kiri & Tengah -->
              <div class="lg:col-span-2 space-y-5">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div class="sm:col-span-2">
                    <label class="block font-bold text-slate-700 mb-1">Nama / Judul Properti *</label>
                    <input type="text" id="prop-title" required placeholder="Contoh: Kos Putri Eksklusif Dekat UB Malang"
                      class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-emerald-500 focus:outline-none" />
                  </div>

                  <div>
                    <label class="block font-bold text-slate-700 mb-1">Kategori Hunian *</label>
                    <select id="prop-category" required
                      class="w-full px-3.5 py-2.5 rounded-xl border-2 border-emerald-500/60 bg-emerald-50/30 font-bold text-slate-900 focus:ring-2 focus:ring-emerald-500 focus:outline-none">
                      <option value="kos">Kos / Indekos</option>
                      <option value="rumah">Rumah / Kontrakan</option>
                      <option value="tanah">Tanah / Kavling</option>
                    </select>
                  </div>

                  <div>
                    <label id="label-block" class="block font-bold text-slate-700 mb-1">Nomor Kamar / Tipe Kamar</label>
                    <input type="text" id="prop-block" placeholder="Contoh: Kamar B-04 (Lantai 1)"
                      class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-emerald-500 focus:outline-none" />
                  </div>

                  <div>
                    <label class="block font-bold text-slate-700 mb-1">Harga (Rupiah) *</label>
                    <input type="number" id="prop-price" required min="10000" placeholder="Contoh: 1500000"
                      class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-emerald-500 focus:outline-none" />
                  </div>

                  <div>
                    <label class="block font-bold text-slate-700 mb-1">Satuan Harga *</label>
                    <select id="prop-unit" required
                      class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 bg-white focus:ring-2 focus:ring-emerald-500 focus:outline-none">
                      <option value="bulan">per Bulan</option>
                      <option value="tahun">per Tahun</option>
                      <option value="unit">per Unit / Jual Putus</option>
                    </select>
                  </div>

                  <div>
                    <label class="block font-bold text-slate-700 mb-1">Status Ketersediaan</label>
                    <select id="prop-status"
                      class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 bg-white focus:ring-2 focus:ring-emerald-500 focus:outline-none">
                      <option value="available">available (Tersedia)</option>
                      <option value="booked">booked (Terkunci / Terisi)</option>
                      <option value="sold">sold (Terjual)</option>
                    </select>
                  </div>

                  <div>
                    <label class="block font-bold text-slate-700 mb-1">Alamat / Lokasi Lengkap *</label>
                    <input type="text" id="prop-location" required placeholder="Contoh: Jl. Veteran No. 12, Kota Malang"
                      class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-emerald-500 focus:outline-none" />
                  </div>

                  <div>
                    <label class="block font-bold text-slate-700 mb-1">Nama Pemasang / Agen</label>
                    <input type="text" id="prop-seller-name" placeholder="Contoh: Admin LapakProperti / Budi Agen"
                      class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-emerald-500 focus:outline-none" />
                  </div>

                  <div>
                    <label class="block font-bold text-slate-700 mb-1">Nomor WhatsApp Penerima Chat *</label>
                    <input type="tel" id="prop-seller-phone" required placeholder="Contoh: 081234567890"
                      class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-emerald-500 focus:outline-none" />
                  </div>
                </div>

                <!-- KOTAK SPESIFIKASI DINAMIS SESUAI KATEGORI -->
                <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200 space-y-3">
                  <div class="flex items-center justify-between">
                    <span id="spec-section-title" class="text-xs font-extrabold text-emerald-800 uppercase tracking-wider">
                      Spesifikasi Khusus Kategori: KOS
                    </span>
                    <span class="text-[10px] text-slate-500">Tampil otomatis di halaman detail pembeli</span>
                  </div>

                  <!-- A. FORM KHUSUS KOS -->
                  <div id="spec-kos" class="spec-group grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                      <label class="block font-semibold text-slate-700 mb-1">Jenis Penghuni Kos</label>
                      <select id="kos-type" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-white">
                        <option value="Khusus Putri">Khusus Putri</option>
                        <option value="Khusus Putra">Khusus Putra</option>
                        <option value="Campur (Putra & Putri)">Campur (Putra & Putri)</option>
                      </select>
                    </div>
                    <div>
                      <label class="block font-semibold text-slate-700 mb-1">Ukuran Kamar</label>
                      <input type="text" id="kos-room-size" placeholder="Contoh: 3 x 4 Meter"
                        class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-white" />
                    </div>
                    <div>
                      <label class="block font-semibold text-slate-700 mb-1">Kamar Mandi</label>
                      <select id="kos-bathroom" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-white">
                        <option value="Kamar Mandi Dalam">Kamar Mandi Dalam</option>
                        <option value="Kamar Mandi Dalam + Water Heater">Kamar Mandi Dalam + Water Heater</option>
                        <option value="Kamar Mandi Luar">Kamar Mandi Luar</option>
                      </select>
                    </div>
                    <div>
                      <label class="block font-semibold text-slate-700 mb-1">Sistem Listrik & Air</label>
                      <select id="kos-electricity" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-white">
                        <option value="Token Listrik Masing-masing">Token Listrik Masing-masing</option>
                        <option value="Sudah Termasuk Listrik & Air">Sudah Termasuk Listrik & Air</option>
                      </select>
                    </div>
                    <div class="sm:col-span-2">
                      <label class="block font-semibold text-slate-700 mb-1">Fasilitas Kamar & Bersama</label>
                      <input type="text" id="kos-facilities" placeholder="Contoh: AC, WiFi 100Mbps, Kasur, Lemari, Dapur Bersama, Parkir Motor"
                        class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-white" />
                    </div>
                  </div>

                  <!-- B. FORM KHUSUS RUMAH -->
                  <div id="spec-rumah" class="spec-group hidden grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                      <label class="block font-semibold text-slate-700 mb-1">Luas Tanah (LT)</label>
                      <input type="text" id="rumah-lt" placeholder="Contoh: 120 m2"
                        class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-white" />
                    </div>
                    <div>
                      <label class="block font-semibold text-slate-700 mb-1">Luas Bangunan (LB)</label>
                      <input type="text" id="rumah-lb" placeholder="Contoh: 90 m2 (2 Lantai)"
                        class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-white" />
                    </div>
                    <div>
                      <label class="block font-semibold text-slate-700 mb-1">Jumlah Kamar Tidur</label>
                      <input type="text" id="rumah-kt" placeholder="Contoh: 3 Kamar Tidur"
