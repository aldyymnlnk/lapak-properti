---
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const API_URL = (import.meta as any).env?.PUBLIC_API_URL || '';
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard Admin Operasional — InfoProperti</title>
    <meta name="robots" content="noindex, nofollow" />
    <style is:global>
      @import '../../styles/global.css';
    </style>
  </head>
  <body class="bg-slate-50 text-slate-900 font-sans min-h-screen flex flex-col justify-between">
    <div>
      <Navbar active="admin" />

      <section class="bg-[#0F172A] text-white py-10 px-4 border-b border-slate-800">
        <div class="max-w-6xl mx-auto flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <div class="flex items-center gap-2 mb-2">
              <span class="px-2.5 py-0.5 rounded bg-emerald-500 text-slate-950 text-[10px] font-black uppercase tracking-wider">
                ADMIN OPERASIONAL
              </span>
              <span id="admin-user-badge" class="text-xs text-slate-400">Memuat sesi...</span>
            </div>
            <h1 class="text-2xl md:text-3xl font-extrabold">Kelola Properti &amp; Verifikasi Booking</h1>
            <p class="text-xs text-slate-300 mt-1">
              Setujui atau tolak pengajuan KTP/NIK pembeli, pantau status pembayaran, dan kelola ketersediaan unit properti.
            </p>
          </div>

          <div class="flex flex-wrap items-center gap-2.5">
            <a id="admin-sa-link" href="/superadmin" class="hidden px-4 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 text-xs font-extrabold transition">
              Pusat Super Admin
            </a>
            <a href="/admin/properties" class="px-4 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-extrabold transition">
              Kelola Katalog Properti
            </a>
            <button type="button" id="btn-admin-refresh" class="px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-xs font-bold cursor-pointer transition">
              Muat Ulang Data
            </button>
          </div>
        </div>
      </section>

      <main class="max-w-6xl mx-auto px-4 py-8 space-y-8">
        <!-- RINGKASAN OPERASIONAL -->
        <section class="grid grid-cols-2 lg:grid-cols-4 gap-4">
          <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-xs">
            <span class="text-[11px] font-bold text-slate-400 uppercase">Menunggu Verifikasi</span>
            <strong id="adm-stat-pending" class="block text-2xl font-black text-amber-600 mt-1">0</strong>
            <span class="text-[11px] text-slate-500">Cek KTP &amp; NIK pemesan</span>
          </div>
          <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-xs">
            <span class="text-[11px] font-bold text-slate-400 uppercase">Disetujui (Siap Bayar)</span>
            <strong id="adm-stat-approved" class="block text-2xl font-black text-blue-600 mt-1">0</strong>
            <span class="text-[11px] text-slate-500">Menunggu pelunasan/DP</span>
          </div>
          <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-xs">
            <span class="text-[11px] font-bold text-slate-400 uppercase">Lunas / Terkunci</span>
            <strong id="adm-stat-paid" class="block text-2xl font-black text-[#059669] mt-1">0</strong>
            <span class="text-[11px] text-slate-500">E-Receipt terbit</span>
          </div>
          <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-xs">
            <span class="text-[11px] font-bold text-slate-400 uppercase">Unit Tersedia</span>
            <strong id="adm-stat-available" class="block text-2xl font-black text-slate-900 mt-1">0</strong>
            <span class="text-[11px] text-slate-500">Siap ditawarkan</span>
          </div>
        </section>

        <!-- DAFTAR PENGAJUAN BOOKING -->
        <section class="bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden">
          <div class="p-5 border-b border-slate-100 flex flex-wrap items-center justify-between gap-3">
            <div>
              <h2 class="text-base font-extrabold text-slate-900">Antrean Pengajuan Booking &amp; KYC</h2>
              <p class="text-[11px] text-slate-500">Verifikasi identitas pemesan sebelum unit dinyatakan terkunci atau lunas.</p>
            </div>
            <div class="flex flex-wrap gap-1.5">
              <button type="button" data-order-filter="ALL" class="ord-filter-btn px-3 py-1.5 rounded-lg bg-[#0F172A] text-white text-xs font-bold cursor-pointer">
                Semua
              </button>
              <button type="button" data-order-filter="PENDING_VERIFICATION" class="ord-filter-btn px-3 py-1.5 rounded-lg bg-slate-100 text-slate-700 hover:bg-slate-200 text-xs font-bold cursor-pointer">
                Pending
              </button>
              <button type="button" data-order-filter="APPROVED" class="ord-filter-btn px-3 py-1.5 rounded-lg bg-slate-100 text-slate-700 hover:bg-slate-200 text-xs font-bold cursor-pointer">
                Disetujui
              </button>
              <button type="button" data-order-filter="PAID" class="ord-filter-btn px-3 py-1.5 rounded-lg bg-slate-100 text-slate-700 hover:bg-slate-200 text-xs font-bold cursor-pointer">
                Lunas
              </button>
            </div>
          </div>

          <div id="admin-orders-list" class="divide-y divide-slate-100 text-xs">
            <div class="p-8 text-center text-slate-400">Memuat daftar pengajuan...</div>
          </div>
        </section>

        <!-- DAFTAR UNIT PROPERTI -->
        <section class="bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden">
          <div class="p-5 border-b border-slate-100 flex items-center justify-between">
            <div>
              <h2 class="text-base font-extrabold text-slate-900">Status Ketersediaan Unit Properti</h2>
              <p class="text-[11px] text-slate-500">Ubah status unit menjadi tersedia atau terkunci bila diperlukan.</p>
            </div>
            <a href="/katalog" class="text-xs font-bold text-[#059669] hover:underline">Lihat Katalog Publik &rarr;</a>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead class="bg-slate-50 text-slate-500 uppercase text-[10px] font-extrabold border-b border-slate-200">
                <tr>
                  <th class="px-4 py-3">Unit Properti</th>
                  <th class="px-4 py-3">Kategori</th>
                  <th class="px-4 py-3">Harga</th>
                  <th class="px-4 py-3">Status</th>
                  <th class="px-4 py-3 text-right">Aksi</th>
                </tr>
              </thead>
              <tbody id="admin-props-tbody" class="divide-y divide-slate-100">
                <tr>
                  <td colspan="5" class="px-4 py-8 text-center text-slate-400">Memuat data properti...</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>
      </main>
    </div>

    <Footer />

    <script is:inline define:vars={{ apiUrl: API_URL }}>
      (function () {
        const API_BASE = apiUrl || '';

        function escapeHtml(str) {
          return String(str == null ? '' : str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
        }

        // ID dipakai di atribut onclick: sisakan hanya karakter aman (UUID / angka)
        function safeId(id) {
          return String(id == null ? '' : id).replace(/[^a-zA-Z0-9_-]/g, '');
        }

        // Hanya izinkan link http(s) atau data:image untuk foto KTP
        function safeUrl(url) {
          const u = String(url || '').trim();
          return /^(https?:\/\/|data:image\/)/i.test(u) ? escapeHtml(u) : '';
        }

        function clearAdminStorage() {
          localStorage.removeItem('lapak_agent');
          localStorage.removeItem('lapak_seller');
          localStorage.removeItem('ip_auth_user');
          localStorage.removeItem('ip_auth_token');
        }

        // Semua request ke API membawa token Bearer; 401 -> kembali ke login admin
        function authFetch(url, opts) {
          opts = opts || {};
          const headers = Object.assign({}, opts.headers || {});
          try {
            const token = localStorage.getItem('ip_auth_token');
            if (token) headers['Authorization'] = 'Bearer ' + token;
          } catch (e) {}
          opts.headers = headers;

          return fetch(url, opts).then((res) => {
            if (res.status === 401) {
              clearAdminStorage();
              window.location.href = '/admin/login';
            }
            return res;
          });
        }

        function getAdminSession() {
          try {
            const rawAuth = localStorage.getItem('ip_auth_user');
            const rawSeller = localStorage.getItem('lapak_seller');
            const raw = rawAuth || rawSeller;
            if (!raw) return null;
            const parsed = JSON.parse(raw);
            if (!parsed || typeof parsed !== 'object') return null;
            return {
              id: parsed.id || '',
              name: parsed.name || 'Admin',
              email: parsed.email || '',
              role: String(parsed.role || '').trim().toUpperCase()
            };
          } catch {
            return null;
          }
        }

        const currentAdmin = getAdminSession();
        const allowedRoles = ['ADMIN', 'SUPER_ADMIN', 'SELLER'];

        if (!currentAdmin) {
          window.location.href = '/admin/login';
          return;
        }

        if (currentAdmin.role === 'AGENT') {
          window.location.href = '/agen';
          return;
        }

        if (!allowedRoles.includes(currentAdmin.role)) {
          window.location.href = '/profil';
          return;
        }

        const badge = document.getElementById('admin-user-badge');
        if (badge) {
          badge.textContent = `${currentAdmin.name} (${currentAdmin.role})`;
        }
        if (currentAdmin.role === 'SUPER_ADMIN') {
          document.getElementById('admin-sa-link')?.classList.remove('hidden');
        }

        let allOrdersCache = [];
        let currentOrderFilter = 'ALL';

        function renderOrdersList() {
          const box = document.getElementById('admin-orders-list');
          if (!box) return;

          const filtered =
            currentOrderFilter === 'ALL'
              ? allOrdersCache
              : allOrdersCache.filter((o) => String(o.status || '').toUpperCase() === currentOrderFilter);

          if (!filtered.length) {
            box.innerHTML = `<div class="p-8 text-center text-slate-400">Tidak ada pengajuan untuk filter ini.</div>`;
            return;
          }

          box.innerHTML = filtered
            .map((o) => {
              const st = String(o.status || 'PENDING_VERIFICATION').toUpperCase();
              const prop = o.properties || {};
              const oid = safeId(o.id);
              const ktpHref = safeUrl(o.ktp_image_url);
              const ktpBtn = ktpHref
                ? `<a href="${ktpHref}" target="_blank" rel="noopener noreferrer" class="px-2.5 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold">Lihat KTP</a>`
                : `<span class="text-[11px] text-slate-400">Tanpa foto KTP</span>`;

              return `
                <div class="p-4 sm:p-5 flex flex-col lg:flex-row lg:items-center justify-between gap-4 hover:bg-slate-50/70">
                  <div class="space-y-1">
                    <div class="flex flex-wrap items-center gap-2">
                      <span class="font-mono text-[11px] font-bold text-slate-400">#${escapeHtml(String(o.id || '').slice(0, 8).toUpperCase())}</span>
                      <span class="px-2.5 py-0.5 rounded-full text-[10px] font-extrabold ${
                        st === 'PAID'
                          ? 'bg-emerald-100 text-emerald-800'
                          : st === 'APPROVED'
                          ? 'bg-blue-100 text-blue-800'
                          : st === 'REJECTED'
                          ? 'bg-rose-100 text-rose-800'
                          : 'bg-amber-100 text-amber-800'
                      }">${escapeHtml(st)}</span>
                    </div>
                    <h3 class="text-sm font-extrabold text-slate-900">${escapeHtml(prop.title || 'Unit Properti')}</h3>
                    <p class="text-[11px] text-slate-600">
                      Pemesan: <strong>${escapeHtml(o.buyer_name || '-')}</strong> • NIK: <span class="font-mono">${escapeHtml(o.buyer_nik || '-')}</span> • WA: <strong>${escapeHtml(o.buyer_phone || '-')}</strong>
                    </p>
                    ${o.notes ? `<p class="text-[11px] text-slate-500">Catatan: ${escapeHtml(o.notes)}</p>` : ''}
                  </div>

                  <div class="flex flex-wrap items-center gap-2 shrink-0">
                    ${ktpBtn}
                    ${
                      st === 'PENDING_VERIFICATION'
                        ? `<button type="button" onclick="updateOrderStatus('${oid}', 'APPROVED')" class="px-3 py-1.5 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-bold cursor-pointer">Setujui (ACC)</button>
                           <button type="button" onclick="updateOrderStatus('${oid}', 'REJECTED')" class="px-3 py-1.5 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-700 font-bold cursor-pointer">Tolak</button>`
                        : ''
                    }
                    ${
                      st === 'APPROVED'
                        ? `<button type="button" onclick="updateOrderStatus('${oid}', 'PAID')" class="px-3 py-1.5 rounded-lg bg-[#059669] hover:bg-emerald-700 text-white font-bold cursor-pointer">Tandai Lunas (PAID)</button>`
                        : ''
                    }
                    <a href="/order/${oid}" class="px-3 py-1.5 rounded-lg border border-slate-200 hover:bg-slate-100 text-slate-700 font-bold">Detail</a>
                  </div>
                </div>
              `;
            })
            .join('');
        }

        function renderPropsTable(props) {
          const tbody = document.getElementById('admin-props-tbody');
          if (!tbody) return;
          if (!Array.isArray(props) || !props.length) {
            tbody.innerHTML = `<tr><td colspan="5" class="px-4 py-8 text-center text-slate-400">Belum ada unit properti.</td></tr>`;
            return;
          }

          tbody.innerHTML = props
            .map((p) => {
              const st = String(p.status || 'AVAILABLE').toUpperCase();
              const isBooked = st === 'BOOKED' || st === 'SOLD';
              const nextStatus = isBooked ? 'AVAILABLE' : 'BOOKED';
              const pid = safeId(p.id);

              return `
                <tr class="hover:bg-slate-50/80">
                  <td class="px-4 py-3">
                    <strong class="block text-slate-900">${escapeHtml(p.title || '-')}</strong>
                    <span class="text-[11px] text-slate-500">${escapeHtml(p.location || '-')}</span>
                  </td>
                  <td class="px-4 py-3 uppercase font-bold text-[11px] text-slate-600">${escapeHtml(p.category || '-')}</td>
                  <td class="px-4 py-3 font-bold text-[#059669]">Rp ${Number(p.price || 0).toLocaleString('id-ID')}</td>
                  <td class="px-4 py-3">
                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-extrabold ${
                      isBooked ? 'bg-rose-50 text-rose-700' : 'bg-emerald-50 text-emerald-700'
                    }">${escapeHtml(st)}</span>
                  </td>
                  <td class="px-4 py-3 text-right space-x-1.5">
                    <button
                      type="button"
                      onclick="togglePropertyStatus('${pid}', '${nextStatus}')"
                      class="px-2.5 py-1 rounded-lg border border-slate-200 hover:bg-slate-100 text-[11px] font-bold text-slate-700 cursor-pointer"
                    >
                      Set ${nextStatus}
                    </button>
                    <a href="/property/${pid}" class="px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-slate-200 text-[11px] font-bold text-slate-700">Lihat</a>
                  </td>
                </tr>
              `;
            })
            .join('');
        }

        async function loadAdminData() {
          try {
            const [ordersRes, propsRes] = await Promise.all([
              authFetch(`${API_BASE}/api/admin/orders?t=${Date.now()}`, { cache: 'no-store' }),
              fetch(`${API_BASE}/api/properties?t=${Date.now()}`, { cache: 'no-store' })
            ]);

            const orders = ordersRes.ok ? await ordersRes.json().catch(() => []) : [];
            const props = propsRes.ok ? await propsRes.json().catch(() => []) : [];

            allOrdersCache = Array.isArray(orders) ? orders : [];
            const safeProps = Array.isArray(props) ? props : [];

            document.getElementById('adm-stat-pending').textContent = String(
              allOrdersCache.filter((o) => String(o.status).toUpperCase() === 'PENDING_VERIFICATION').length
            );
            document.getElementById('adm-stat-approved').textContent = String(
              allOrdersCache.filter((o) => String(o.status).toUpperCase() === 'APPROVED').length
            );
            document.getElementById('adm-stat-paid').textContent = String(
              allOrdersCache.filter((o) => String(o.status).toUpperCase() === 'PAID').length
            );
            document.getElementById('adm-stat-available').textContent = String(
              safeProps.filter((p) => !['BOOKED', 'SOLD'].includes(String(p.status || '').toUpperCase())).length
            );

            renderOrdersList();
            renderPropsTable(safeProps);
          } catch (err) {
            console.error('Gagal memuat data Admin:', err);
          }
        }

        window.updateOrderStatus = async (orderId, status) => {
          const res = await authFetch(`${API_BASE}/api/admin/orders/${encodeURIComponent(String(orderId))}`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ status })
          });
          const data = await res.json().catch(() => ({}));
          if (res.ok) {
            loadAdminData();
          } else {
            alert(data.error || 'Gagal memperbarui status pengajuan.');
          }
        };

        window.togglePropertyStatus = async (propId, status) => {
          const res = await authFetch(`${API_BASE}/api/admin/properties/${encodeURIComponent(String(propId))}`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ status })
          });
          const data = await res.json().catch(() => ({}));
          if (res.ok) {
            loadAdminData();
          } else {
            alert(data.error || 'Gagal mengubah status properti.');
          }
        };

        document.querySelectorAll('.ord-filter-btn').forEach((btn) => {
          btn.addEventListener('click', () => {
            document.querySelectorAll('.ord-filter-btn').forEach((b) => {
              b.className = 'ord-filter-btn px-3 py-1.5 rounded-lg bg-slate-100 text-slate-700 hover:bg-slate-200 text-xs font-bold cursor-pointer';
            });
            btn.className = 'ord-filter-btn px-3 py-1.5 rounded-lg bg-[#0F172A] text-white text-xs font-bold cursor-pointer';
            currentOrderFilter = btn.getAttribute('data-order-filter') || 'ALL';
            renderOrdersList();
          });
        });

        document.getElementById('btn-admin-refresh')?.addEventListener('click', loadAdminData);
        loadAdminData();
      })();
    </script>
  </body>
</html>