                        </td>
                        <td class="px-5 py-4 font-bold text-slate-800">
                          {unitCount} Unit
                        </td>
                        <td class="px-5 py-4">
                          <span class={`inline-block px-2.5 py-1 rounded-full text-[10px] font-bold ${
                            isActive
                              ? 'bg-emerald-100 text-emerald-700 border border-emerald-200'
                              : 'bg-rose-100 text-rose-700 border border-rose-200'
                          }`}>
                            {isActive ? 'AKTIF' : 'NONAKTIF'}
                          </span>
                        </td>
                        <td class="px-5 py-4 text-right">
                          <button
                            type="button"
                            onclick={`window.toggleAgentAccount('${ag.id}', ${isActive ? 'false' : 'true'})`}
                            class={`px-3 py-1.5 rounded-lg text-[11px] font-bold text-white transition cursor-pointer ${
                              isActive
                                ? 'bg-rose-600 hover:bg-rose-700'
                                : 'bg-[#059669] hover:bg-emerald-700'
                            }`}
                          >
                            {isActive ? 'Nonaktifkan' : 'Aktifkan'}
                          </button>
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>

              {agents.length === 0 && (
                <div class="text-center py-12 text-slate-400">
                  <p class="text-xs">Belum ada mitra agen yang mendaftar melalui /agen/login.</p>
                </div>
              )}
            </div>
          </div>
        </section>

      </main>
    </div>

    <!-- MODAL PREVIEW FOTO KTP PEMBELI -->
    <div id="ktp-modal" class="hidden fixed inset-0 z-50 bg-slate-900/75 backdrop-blur-xs flex items-center justify-center p-4">
      <div class="bg-white rounded-2xl max-w-lg w-full p-6 shadow-2xl space-y-4">
        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
          <div>
            <h4 class="text-base font-extrabold text-slate-900">Verifikasi Identitas KTP (KYC)</h4>
            <p id="modal-ktp-info" class="text-xs text-slate-500 mt-0.5">-</p>
          </div>
          <button type="button" onclick="window.closeKtpModal()" class="text-slate-400 hover:text-slate-800 font-bold text-sm px-2 py-1 cursor-pointer">
            ✕
          </button>
        </div>
        <div class="bg-slate-100 rounded-xl overflow-hidden border border-slate-200">
          <img id="modal-ktp-img" src="" alt="Foto KTP Pembeli" class="w-full max-h-80 object-contain mx-auto" />
        </div>
        <div class="flex justify-end gap-2 pt-2">
          <button type="button" onclick="window.closeKtpModal()" class="px-4 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold cursor-pointer">
            Tutup
          </button>
        </div>
      </div>
    </div>

    <script is:inline define:vars={{ initialOrders: orders, initialProperties: properties, apiUrl: API_URL }}>
      (function () {
        var TOAST_KEY = 'lp_admin_toast_next';
        var ALLOWED_STATUSES = ['available', 'booked', 'sold'];

        function escapeHtml(str) {
          return String(str || '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
        }

        function showAdminToast(type, title, message) {
          var container = document.getElementById('admin-toast-container');
          if (!container) return;

          var isError = type === 'error';
          var cardClass = isError
            ? 'bg-white border-l-4 border-l-rose-600 border border-rose-200 text-slate-900'
            : 'bg-white border-l-4 border-l-emerald-600 border border-emerald-200 text-slate-900';
          var badgeClass = isError
            ? 'bg-rose-100 text-rose-700'
            : 'bg-emerald-100 text-emerald-700';
          var badgeText = isError ? 'Gagal' : 'Berhasil';

          var toast = document.createElement('div');
          toast.className =
            'pointer-events-auto rounded-xl shadow-lg p-3.5 flex items-start justify-between gap-3 transition-all duration-300 ' +
            cardClass;

          toast.innerHTML =
            '<div class="min-w-0 flex-1 space-y-1">' +
            '<div class="flex items-center gap-2">' +
            '<span class="text-[10px] font-extrabold uppercase tracking-wider px-2 py-0.5 rounded-full ' +
            badgeClass +
            '">' +
            badgeText +
            '</span>' +
            '<strong class="text-xs font-extrabold text-slate-900 truncate">' +
            escapeHtml(title || (isError ? 'Terjadi Kesalahan' : 'Terkirim ke Katalog')) +
            '</strong>' +
            '</div>' +
            '<p class="text-xs text-slate-600 leading-snug break-words">' +
            escapeHtml(message || '') +
            '</p>' +
            '</div>' +
            '<button type="button" aria-label="Tutup notifikasi" class="text-slate-400 hover:text-slate-700 text-xs font-bold px-1.5 py-0.5 rounded cursor-pointer">✕</button>';

          var closeBtn = toast.querySelector('button');
          function dismissToast() {
            toast.style.opacity = '0';
            toast.style.transform = 'translateX(12px)';
            setTimeout(function () {
              if (toast.parentNode) toast.parentNode.removeChild(toast);
            }, 220);
          }

          if (closeBtn) closeBtn.addEventListener('click', dismissToast);
          container.appendChild(toast);
          setTimeout(dismissToast, isError ? 5500 : 4200);
        }

        function queueToast(type, title, message) {
          try {
            sessionStorage.setItem(TOAST_KEY, JSON.stringify({ type: type, title: title, message: message }));
          } catch {}
        }

        function flushToast() {
          try {
            var raw = sessionStorage.getItem(TOAST_KEY);
            if (!raw) return;
            sessionStorage.removeItem(TOAST_KEY);
            var parsed = JSON.parse(raw);
            if (parsed && parsed.message) {
              showAdminToast(parsed.type || 'success', parsed.title || 'Berhasil', parsed.message);
            }
          } catch {}
        }

        flushToast();

        function normalizeStatus(val) {
          var s = String(val || 'available').trim().toLowerCase();
          return ALLOWED_STATUSES.indexOf(s) !== -1 ? s : 'available';
        }

        function compressImageFile(file, callback) {
          if (!file) return;
          if (file.size > 5 * 1024 * 1024) {
            showAdminToast('error', 'Ukuran File Berlebih', 'Ukuran setiap foto maksimal 5MB.');
            return;
          }
          const reader = new FileReader();
          reader.onload = (event) => {
            const img = new Image();
            img.onload = () => {
              const canvas = document.createElement('canvas');
              const maxWidth = 900;
              const scale = img.width > maxWidth ? maxWidth / img.width : 1;
              canvas.width = img.width * scale;
              canvas.height = img.height * scale;
              const ctx = canvas.getContext('2d');
              ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
              callback(canvas.toDataURL('image/jpeg', 0.8));
            };
            img.src = event.target.result;
          };
          reader.readAsDataURL(file);
        }

        let currentSeller = null;

        // Proteksi Wajib Login Admin
        const rawSeller = localStorage.getItem('lapak_seller');
        if (!rawSeller) {
          window.location.href = '/admin/login';
        } else {
          try {
            currentSeller = JSON.parse(rawSeller);
            const nameEl = document.getElementById('sidebar-admin-name');
            const emailEl = document.getElementById('sidebar-admin-email');
            if (nameEl && currentSeller && currentSeller.name) nameEl.textContent = currentSeller.name;
            if (emailEl && currentSeller && currentSeller.email) emailEl.textContent = currentSeller.email;

            const sellerNameInput = document.getElementById('prop-seller-name');
            const sellerPhoneInput = document.getElementById('prop-seller-phone');
            if (sellerNameInput && !sellerNameInput.value && currentSeller && currentSeller.name) {
              sellerNameInput.value = currentSeller.name;
            }
            if (sellerPhoneInput && !sellerPhoneInput.value && currentSeller && currentSeller.phone) {
              sellerPhoneInput.value = currentSeller.phone;
            }
          } catch {}
        }

        window.logoutAdmin = function () {
          localStorage.removeItem('lapak_seller');
          window.location.href = '/admin/login';
        };

        const API_BASE = apiUrl || 'http://localhost:5000';
        const headings = {
          'tab-stats': 'Statistik & Ringkasan Bisnis',
          'tab-properties': 'Kelola & Posting Properti Katalog',
          'tab-orders': 'Log Pengajuan & Laporan Transaksi',
          'tab-agents': 'Portal & Manajemen Mitra Agen'
        };

        window.switchSidebarTab = function (targetId) {
          document.querySelectorAll('.tab-panel').forEach((panel) => panel.classList.add('hidden'));
          const el = document.getElementById(targetId);
          if (el) el.classList.remove('hidden');

          document.querySelectorAll('.sidebar-btn').forEach((btn) => {
            if (btn.getAttribute('data-target') === targetId) {
              btn.classList.add('bg-emerald-600', 'text-white');
              btn.classList.remove('text-slate-300', 'hover:bg-slate-800');
            } else {
              btn.classList.remove('bg-emerald-600', 'text-white');
              btn.classList.add('text-slate-300', 'hover:bg-slate-800');
            }
          });

          const headingEl = document.getElementById('page-heading');
          if (headingEl && headings[targetId]) headingEl.textContent = headings[targetId];
        };

        document.querySelectorAll('.sidebar-btn').forEach((btn) => {
          btn.addEventListener('click', () => {
            const target = btn.getAttribute('data-target');
            if (target) window.switchSidebarTab(target);
          });
        });

        window.toggleAgentAccount = async function (agentId, nextActiveState) {
          const label = nextActiveState ? 'MENGAKTIFKAN' : 'MENONAKTIFKAN';
          if (!confirm(`Yakin ingin ${label} akun agen ini?`)) return;

          try {
            const res = await fetch(`${API_BASE}/api/admin/agents/${agentId}/status`, {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ is_active: nextActiveState })
            });
            const data = await res.json().catch(() => ({}));
            if (res.ok) {
              queueToast('success', 'Status Akun Agen', data.message || 'Status akun agen berhasil diperbarui.');
              window.location.reload();
            } else {
              showAdminToast('error', 'Gagal Perbarui Agen', data.error || 'Gagal memperbarui status agen.');
            }
          } catch {
            showAdminToast('error', 'Koneksi Gagal', 'Koneksi ke server backend gagal.');
          }
        };

        window.previewKtpModal = function (orderId) {
          const order = initialOrders.find((o) => String(o.id) === String(orderId));
          if (!order || !order.ktp_image_url) return;
          document.getElementById('modal-ktp-info').textContent = `Pemesan: ${order.buyer_name} • NIK: ${order.buyer_nik || '-'}`;
          document.getElementById('modal-ktp-img').src = order.ktp_image_url;
          document.getElementById('ktp-modal').classList.remove('hidden');
        };

        window.closeKtpModal = function () {
          document.getElementById('ktp-modal').classList.add('hidden');
        };

        const categorySelect = document.getElementById('prop-category');
        const unitSelect = document.getElementById('prop-unit');
        const labelBlock = document.getElementById('label-block');
        const inputBlock = document.getElementById('prop-block');
        const specSectionTitle = document.getElementById('spec-section-title');

        function updateDynamicCategoryFields(cat, autoSetUnit = true) {
          document.querySelectorAll('.spec-group').forEach((el) => el.classList.add('hidden'));
          const activeGroup = document.getElementById(`spec-${cat}`);
          if (activeGroup) activeGroup.classList.remove('hidden');

          if (cat === 'kos') {
            specSectionTitle.textContent = 'Spesifikasi Khusus Kategori: KOS';
            labelBlock.textContent = 'Nomor Kamar / Lantai';
            inputBlock.placeholder = 'Contoh: Kamar A-01 (Lantai 1)';
            if (autoSetUnit) unitSelect.value = 'bulan';
          } else if (cat === 'rumah') {
            specSectionTitle.textContent = 'Spesifikasi Khusus Kategori: RUMAH';
            labelBlock.textContent = 'Blok / Nomor Rumah';
            inputBlock.placeholder = 'Contoh: Blok B2 No. 10';
            if (autoSetUnit) unitSelect.value = 'tahun';
          } else if (cat === 'tanah') {
            specSectionTitle.textContent = 'Spesifikasi Khusus Kategori: TANAH / KAVLING';
            labelBlock.textContent = 'Nomor Kavling / Lot';
            inputBlock.placeholder = 'Contoh: Kavling K-05';
            if (autoSetUnit) unitSelect.value = 'unit';
          }
        }

        if (categorySelect) {
          categorySelect.addEventListener('change', (e) => {
            updateDynamicCategoryFields(e.target.value, true);
          });
        }

        // ================= MANAJEMEN FOTO SAMPUL + GALERI PENDUKUNG DINAMIS =================
        const imgInput = document.getElementById('prop-image');
        const fileInput = document.getElementById('prop-file');
        const fileNameLabel = document.getElementById('file-name-label');
        const imgPreview = document.getElementById('image-preview');
        const coverPreviewWrapper = document.getElementById('cover-preview-wrapper');
        const btnRemoveCover = document.getElementById('btn-remove-cover');
        const modeUploadBtn = document.getElementById('mode-upload-btn');
        const modeUrlBtn = document.getElementById('mode-url-btn');
        const boxUploadFile = document.getElementById('box-upload-file');
        const boxInputUrl = document.getElementById('box-input-url');

        const galleryContainer = document.getElementById('gallery-slots-container');
        const galleryEmptyHint = document.getElementById('gallery-empty-hint');
        const btnAddGallerySlot = document.getElementById('btn-add-gallery-slot');
        let galleryPhotosState = [];

        function syncCoverPreview() {
          const val = (imgInput && imgInput.value ? imgInput.value : '').trim();
          if (val) {
            imgPreview.src = val;
            coverPreviewWrapper.classList.remove('hidden');
          } else {
            imgPreview.src = '';
            coverPreviewWrapper.classList.add('hidden');
          }
        }

        function renderGallerySlots() {
          if (!galleryContainer) return;
          galleryContainer.innerHTML = '';
          if (galleryEmptyHint) {
            galleryEmptyHint.classList.toggle('hidden', galleryPhotosState.length > 0);
          }

          galleryPhotosState.forEach((photoVal, idx) => {
            const slot = document.createElement('div');
            slot.className = 'p-2.5 rounded-xl bg-slate-50 border border-slate-200 space-y-2';

            const header = document.createElement('div');
            header.className = 'flex items-center justify-between';
            header.innerHTML = `<span class="text-[11px] font-bold text-slate-700">Foto Pendukung #${idx + 1}</span>`;

            const delBtn = document.createElement('button');
            delBtn.type = 'button';
            delBtn.className = 'text-[10px] font-bold text-rose-600 hover:underline cursor-pointer';
            delBtn.textContent = 'Hapus Foto ✕';
            delBtn.addEventListener('click', () => {
              galleryPhotosState.splice(idx, 1);
              renderGallerySlots();
            });
            header.appendChild(delBtn);
            slot.appendChild(header);

            const controls = document.createElement('div');
            controls.className = 'flex items-center gap-1.5';

            const fileLabel = document.createElement('label');
            fileLabel.className = 'shrink-0 px-2.5 py-1.5 rounded-lg bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-emerald-300 text-[10px] font-bold cursor-pointer transition';
            fileLabel.textContent = 'Upload';
            const hiddenFile = document.createElement('input');
            hiddenFile.type = 'file';
            hiddenFile.accept = 'image/*';
            hiddenFile.className = 'hidden';
            hiddenFile.addEventListener('change', (ev) => {
              const f = ev.target.files && ev.target.files[0];
              if (!f) return;
              compressImageFile(f, (dataUrl) => {
                galleryPhotosState[idx] = dataUrl;
                renderGallerySlots();
              });
            });
            fileLabel.appendChild(hiddenFile);

            const urlField = document.createElement('input');
            urlField.type = 'text';
            urlField.placeholder = 'Atau tempel URL foto...';
            urlField.value = photoVal && !photoVal.startsWith('data:') ? photoVal : '';
            urlField.className = 'w-full px-2.5 py-1.5 rounded-lg border border-slate-300 bg-white text-[11px] focus:outline-none focus:ring-1 focus:ring-emerald-500';
            urlField.addEventListener('input', (ev) => {
              galleryPhotosState[idx] = ev.target.value.trim();
              const prev = slot.querySelector('.slot-preview-img');
              if (prev) {
                if (galleryPhotosState[idx]) {
                  prev.src = galleryPhotosState[idx];
                  prev.classList.remove('hidden');
                } else {
                  prev.classList.add('hidden');
                }
              }
            });

            controls.appendChild(fileLabel);
            controls.appendChild(urlField);
            slot.appendChild(controls);

            const previewImg = document.createElement('img');
            previewImg.alt = `Foto Pendukung ${idx + 1}`;
            previewImg.className = 'slot-preview-img w-full h-24 object-cover rounded-lg border border-slate-200 bg-white ' + (photoVal ? '' : 'hidden');
            if (photoVal) previewImg.src = photoVal;
            slot.appendChild(previewImg);

            galleryContainer.appendChild(slot);
          });
        }

        if (btnAddGallerySlot) {
          btnAddGallerySlot.addEventListener('click', () => {
            galleryPhotosState.push('');
            renderGallerySlots();
          });
        }

        function setImageMode(mode) {
          if (mode === 'upload') {
            modeUploadBtn.classList.add('bg-white', 'text-slate-900', 'shadow-xs');
            modeUploadBtn.classList.remove('text-slate-600');
            modeUrlBtn.classList.remove('bg-white', 'text-slate-900', 'shadow-xs');
            modeUrlBtn.classList.add('text-slate-600');
            boxUploadFile.classList.remove('hidden');
            boxInputUrl.classList.add('hidden');
          } else {
            modeUrlBtn.classList.add('bg-white', 'text-slate-900', 'shadow-xs');
            modeUrlBtn.classList.remove('text-slate-600');
            modeUploadBtn.classList.remove('bg-white', 'text-slate-900', 'shadow-xs');
            modeUploadBtn.classList.add('text-slate-600');
            boxInputUrl.classList.remove('hidden');
            boxUploadFile.classList.add('hidden');
          }
        }

        if (modeUploadBtn) modeUploadBtn.addEventListener('click', () => setImageMode('upload'));
        if (modeUrlBtn) modeUrlBtn.addEventListener('click', () => setImageMode('url'));

        if (imgInput) {
          imgInput.addEventListener('input', syncCoverPreview);
        }

        if (btnRemoveCover) {
          btnRemoveCover.addEventListener('click', () => {
            imgInput.value = '';
            if (fileInput) fileInput.value = '';
            fileNameLabel.textContent = 'JPG, PNG, WebP (Maks. 5MB)';
            syncCoverPreview();
          });
        }

        if (fileInput) {
          fileInput.addEventListener('change', (e) => {
            const file = e.target.files && e.target.files[0];
            if (!file) return;
            fileNameLabel.textContent = `Terpilih: ${file.name}`;
            compressImageFile(file, (compressedDataUrl) => {
              imgInput.value = compressedDataUrl;
              syncCoverPreview();
            });
          });
        }

        function collectCategorySpecifications(cat, cleanedGallery) {
          const preservedAgentId = document.getElementById('prop-agent-id').value.trim();
          const preservedAgentEmail = document.getElementById('prop-agent-email').value.trim();

          const sellerInfo = {
            seller_name: document.getElementById('prop-seller-name').value.trim() || (currentSeller && currentSeller.name) || 'Admin LapakProperti',
            seller_phone: document.getElementById('prop-seller-phone').value.trim() || (currentSeller && currentSeller.phone) || '081234567890',
            gallery: cleanedGallery
          };

          if (preservedAgentId) sellerInfo.agent_id = preservedAgentId;
          if (preservedAgentEmail) sellerInfo.agent_email = preservedAgentEmail;

          if (cat === 'kos') {
            return Object.assign({}, sellerInfo, {
              kos_type: document.getElementById('kos-type').value,
              room_size: document.getElementById('kos-room-size').value.trim(),
              bathroom: document.getElementById('kos-bathroom').value,
              electricity: document.getElementById('kos-electricity').value,
              facilities: document.getElementById('kos-facilities').value.trim()
            });
          }
          if (cat === 'rumah') {
            return Object.assign({}, sellerInfo, {
              land_area: document.getElementById('rumah-lt').value.trim(),
              building_area: document.getElementById('rumah-lb').value.trim(),
              bedrooms: document.getElementById('rumah-kt').value.trim(),
              bathrooms: document.getElementById('rumah-km').value.trim(),
              utilities: document.getElementById('rumah-utilities').value.trim(),
              legality: document.getElementById('rumah-legality').value.trim()
            });
          }
          return Object.assign({}, sellerInfo, {
            land_area: document.getElementById('tanah-area').value.trim(),
            dimensions: document.getElementById('tanah-dimensions').value.trim(),
            certificate: document.getElementById('tanah-certificate').value,
            zoning: document.getElementById('tanah-zoning').value.trim(),
            road_access: document.getElementById('tanah-road').value.trim()
          });
        }

        function populateCategorySpecifications(cat, specs = {}) {
          if (!specs || typeof specs !== 'object') return;
          document.getElementById('prop-agent-id').value = specs.agent_id || '';
          document.getElementById('prop-agent-email').value = specs.agent_email || '';
          document.getElementById('prop-seller-name').value = specs.seller_name || '';
          document.getElementById('prop-seller-phone').value = specs.seller_phone || '';

          if (cat === 'kos') {
            if (specs.kos_type) document.getElementById('kos-type').value = specs.kos_type;
            document.getElementById('kos-room-size').value = specs.room_size || '';
            if (specs.bathroom) document.getElementById('kos-bathroom').value = specs.bathroom;
            if (specs.electricity) document.getElementById('kos-electricity').value = specs.electricity;
            document.getElementById('kos-facilities').value = specs.facilities || '';
          } else if (cat === 'rumah') {
            document.getElementById('rumah-lt').value = specs.land_area || '';
            document.getElementById('rumah-lb').value = specs.building_area || '';
            document.getElementById('rumah-kt').value = specs.bedrooms || '';
            document.getElementById('rumah-km').value = specs.bathrooms || '';
            document.getElementById('rumah-utilities').value = specs.utilities || '';
            document.getElementById('rumah-legality').value = specs.legality || '';
          } else if (cat === 'tanah') {
            document.getElementById('tanah-area').value = specs.land_area || '';
            document.getElementById('tanah-dimensions').value = specs.dimensions || '';
            if (specs.certificate) document.getElementById('tanah-certificate').value = specs.certificate;
            document.getElementById('tanah-zoning').value = specs.zoning || '';
            document.getElementById('tanah-road').value = specs.road_access || '';
          }
        }

        window.togglePropertyStatus = async function (propId, currentStatus) {
          const st = normalizeStatus(currentStatus);
          const nextStatus = st === 'available' ? 'booked' : 'available';
          try {
            const res = await fetch(`${API_BASE}/api/admin/properties/${propId}`, {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ status: nextStatus })
            });
            if (res.ok) {
              queueToast('success', 'Status Diperbarui', `Status unit diubah menjadi "${nextStatus}" di katalog.`);
              window.location.reload();
            } else {
              const errData = await res.json().catch(() => ({}));
              showAdminToast('error', 'Gagal Ubah Status', errData.error || 'Gagal memperbarui status unit.');
            }
          } catch {
            showAdminToast('error', 'Koneksi Gagal', 'Koneksi ke backend gagal.');
          }
        };

        window.syncAllToGoogleSheets = async function () {
          const btn = document.getElementById('btn-sync-gsheet');
          const originalHtml = btn ? btn.innerHTML : '';
          if (btn) {
            btn.disabled = true;
            btn.innerHTML = '<span>Menyinkronkan...</span>';
          }

          try {
            const res = await fetch(`${API_BASE}/api/admin/sync-sheets`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' }
            });
            const data = await res.json().catch(() => ({}));

            if (res.ok) showAdminToast('success', 'Sinkronisasi Sheets', data.message || 'Data berhasil disinkronkan ke Google Sheets.');
            else showAdminToast('error', 'Gagal Sync Sheets', data.error || 'Gagal menyinkronkan ke Google Sheets.');
          } catch {
            showAdminToast('error', 'Koneksi Gagal', 'Gagal terhubung ke server backend.');
          } finally {
            if (btn) {
              btn.disabled = false;
              btn.innerHTML = originalHtml;
            }
          }
        };

        window.exportOrdersToCSV = function () {
          if (!initialOrders || initialOrders.length === 0) {
            showAdminToast('error', 'Ekspor CSV Batal', 'Belum ada data pembelian untuk diekspor ke CSV.');
            return;
          }

          const headers = ['ID Order', 'Tanggal', 'Nama Properti', 'Kategori', 'Blok/Unit', 'Harga', 'Nama Pembeli', 'NIK KTP', 'No WhatsApp', 'Catatan', 'Status'];
          const rows = initialOrders.map((o) => [
            o.id,
            o.created_at ? new Date(o.created_at).toLocaleString('id-ID') : '-',
            `"${((o.properties && o.properties.title) || '').replace(/"/g, '""')}"`,
            (o.properties && o.properties.category) || '-',
            `"${((o.properties && o.properties.block_or_unit) || '-').replace(/"/g, '""')}"`,
            (o.properties && o.properties.price) || 0,
            `"${(o.buyer_name || '').replace(/"/g, '""')}"`,
            `'${o.buyer_nik || '-'}`,
            `'${o.buyer_phone || ''}`,
            `"${(o.notes || '-').replace(/"/g, '""')}"`,
            o.status
          ]);

          const csvContent = 'data:text/csv;charset=utf-8,' + [headers.join(','), ...rows.map((e) => e.join(','))].join('\n');
          const encodedUri = encodeURI(csvContent);
          const link = document.createElement('a');
          link.setAttribute('href', encodedUri);
          link.setAttribute('download', `Laporan_LapakProperti_${new Date().toISOString().slice(0, 10)}.csv`);
          document.body.appendChild(link);
          link.click();
          document.body.removeChild(link);
          showAdminToast('success', 'Ekspor Berhasil', 'File CSV laporan transaksi berhasil diunduh.');
        };

        window.verifyOrder = async function (orderId, status) {
          const label = status === 'APPROVED' ? 'MENYETUJUI (ACC)' : 'MENOLAK';
          if (!confirm(`Yakin ingin ${label} pesanan #${String(orderId).slice(0, 8)}?`)) return;

          try {
            const res = await fetch(`${API_BASE}/api/admin/orders/${orderId}/verify`, {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ status })
            });
            const data = await res.json().catch(() => ({}));
            if (res.ok) {
              queueToast('success', 'Verifikasi Order', data.message || `Status pesanan berhasil diubah menjadi ${status}`);
              window.location.reload();
            } else {
              showAdminToast('error', 'Gagal Verifikasi', data.error || 'Gagal memproses verifikasi.');
            }
          } catch {
            showAdminToast('error', 'Koneksi Gagal', 'Koneksi ke server backend gagal.');
          }
        };

        window.loadEditProperty = function (propId) {
          const item = initialProperties.find((p) => String(p.id) === String(propId));
          if (!item) return;

          window.switchSidebarTab('tab-properties');
          const cat = (item.category || 'kos').toLowerCase();
          document.getElementById('prop-id').value = item.id;
          document.getElementById('prop-title').value = item.title || '';
          categorySelect.value = cat;
          updateDynamicCategoryFields(cat, false);
          populateCategorySpecifications(cat, item.specifications || {});

          document.getElementById('prop-block').value = item.block_or_unit || '';
          document.getElementById('prop-price').value = item.price || '';
          document.getElementById('prop-unit').value = item.price_unit || 'bulan';
          document.getElementById('prop-status').value = normalizeStatus(item.status);
          document.getElementById('prop-location').value = item.location || '';
          document.getElementById('prop-description').value = item.description || '';
          document.getElementById('prop-image').value = item.image_url || '';
          syncCoverPreview();
          fileNameLabel.textContent = 'Ganti foto sampul dari perangkat atau link URL';

          const existingGallery = Array.isArray(item.gallery)
            ? item.gallery
            : (Array.isArray(item.specifications?.gallery) ? item.specifications.gallery : []);
          galleryPhotosState = existingGallery.filter(Boolean);
          renderGallerySlots();

          document.getElementById('form-prop-heading').textContent = `Edit Unit: ${item.title}`;
          document.getElementById('btn-submit-label').textContent = 'Simpan Perubahan Unit';
          document.getElementById('btn-cancel-edit').classList.remove('hidden');
          window.scrollTo({ top: 0, behavior: 'smooth' });
        };

        const btnCancelEdit = document.getElementById('btn-cancel-edit');
        if (btnCancelEdit) {
          btnCancelEdit.addEventListener('click', () => {
            document.getElementById('prop-id').value = '';
            document.getElementById('prop-agent-id').value = '';
            document.getElementById('prop-agent-email').value = '';
            document.getElementById('cms-property-form').reset();
            updateDynamicCategoryFields('kos', true);
            imgInput.value = '';
            syncCoverPreview();
            galleryPhotosState = [];
            renderGallerySlots();
            fileNameLabel.textContent = 'JPG, PNG, WebP (Maks. 5MB)';
            setImageMode('upload');
            document.getElementById('form-prop-heading').textContent = 'Posting Properti Baru ke Katalog';
            document.getElementById('btn-submit-label').textContent = 'Posting ke Katalog Sekarang';
            btnCancelEdit.classList.add('hidden');
          });
        }

        const cmsForm = document.getElementById('cms-property-form');
        if (cmsForm) {
          cmsForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const coverVal = (document.getElementById('prop-image').value || '').trim();
            if (!coverVal) {
              showAdminToast('error', 'Foto Sampul Wajib', 'Harap unggah atau masukkan minimal 1 Foto Sampul Utama sebelum memposting properti.');
              return;
            }

            const btnSubmit = document.getElementById('btn-submit-property');
            const btnLabel = document.getElementById('btn-submit-label');
            const origLabel = btnLabel ? btnLabel.textContent : 'Posting ke Katalog Sekarang';

            const id = document.getElementById('prop-id').value;
            const category = categorySelect.value;
            const titleVal = document.getElementById('prop-title').value.trim();
            const cleanedGallery = galleryPhotosState.map((u) => String(u || '').trim()).filter(Boolean);

            const payload = {
              title: titleVal,
              category: category,
              block_or_unit: document.getElementById('prop-block').value.trim(),
              price: Number(document.getElementById('prop-price').value),
              price_unit: document.getElementById('prop-unit').value,
              status: normalizeStatus(document.getElementById('prop-status').value),
              location: document.getElementById('prop-location').value.trim(),
              description: document.getElementById('prop-description').value.trim(),
              specifications: collectCategorySpecifications(category, cleanedGallery),
              image_url: coverVal,
              gallery: cleanedGallery
            };

            const url = id ? `${API_BASE}/api/admin/properties/${id}` : `${API_BASE}/api/admin/properties`;
            const method = id ? 'PUT' : 'POST';

            if (btnSubmit) btnSubmit.disabled = true;
            if (btnLabel) btnLabel.textContent = 'Mengirim ke Katalog...';

            try {
              const res = await fetch(url, {
                method,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
              });
              const data = await res.json().catch(() => ({}));

              if (res.ok) {
                const msg = id
                  ? `Perubahan unit "${titleVal}" berhasil disimpan (${1 + cleanedGallery.length} foto).`
                  : `Unit "${titleVal}" berhasil diposting ke katalog (${1 + cleanedGallery.length} foto).`;
                queueToast('success', id ? 'Unit Diperbarui' : 'Terkirim ke Katalog', data.message || msg);
                window.location.reload();
              } else {
                showAdminToast('error', 'Gagal Menyimpan Unit', data.error || 'Gagal menyimpan properti.');
                if (btnSubmit) btnSubmit.disabled = false;
                if (btnLabel) btnLabel.textContent = origLabel;
              }
            } catch {
              showAdminToast('error', 'Koneksi Gagal', 'Gagal terhubung ke server backend.');
              if (btnSubmit) btnSubmit.disabled = false;
              if (btnLabel) btnLabel.textContent = origLabel;
            }
          });
        }

        window.removeProperty = async function (propId) {
          const item = initialProperties.find((p) => String(p.id) === String(propId));
          const propTitle = (item && item.title) || 'unit ini';
          if (!confirm(`Hapus unit "${propTitle}" dari katalog?`)) return;
          try {
            const res = await fetch(`${API_BASE}/api/admin/properties/${propId}`, { method: 'DELETE' });
            if (res.ok) {
              queueToast('success', 'Unit Dihapus', `"${propTitle}" telah dihapus dari katalog.`);
              window.location.reload();
            } else {
              const errData = await res.json().catch(() => ({}));
              showAdminToast('error', 'Gagal Menghapus', errData.error || 'Gagal menghapus unit.');
            }
          } catch {
            showAdminToast('error', 'Koneksi Gagal', 'Koneksi ke backend gagal.');
          }
        };
      })();
    </script>
  </body>
</html>
