---
interface Props {
  active?:
    | 'beranda'
    | 'tentang'
    | 'katalog'
    | 'galeri'
    | 'blog'
    | 'kontak'
    | 'daftar'
    | 'masuk'
    | 'profil'
    | 'pesanan'
    | 'superadmin'
    | 'admin'
    | 'agen'
    | 'syarat-ketentuan'
    | 'kebijakan-privasi';
  hideBreadcrumb?: boolean;
}

const { active, hideBreadcrumb } = Astro.props;

const navLinks = [
  { key: 'beranda', label: 'Beranda', href: '/' },
  { key: 'tentang', label: 'Tentang', href: '/tentang' },
  { key: 'katalog', label: 'Katalog', href: '/katalog' },
  { key: 'galeri', label: 'Galeri', href: '/galeri' },
  { key: 'blog', label: 'Blog', href: '/blog' },
  { key: 'kontak', label: 'Kontak', href: '/kontak' }
];

const currentPath: string = Astro.url.pathname.replace(/\/+$/, '') || '/';
const firstSegment = currentPath.split('/').filter(Boolean)[0] || 'beranda';
const currentActive = (active ||
  (firstSegment === 'property' ? 'katalog' : firstSegment)) as NonNullable<Props['active']>;
---

<header class="bg-[#0F172A]/95 backdrop-blur-md text-white py-3.5 shadow-lg sticky top-0 z-50 border-b border-slate-800/90">
  <div class="max-w-6xl mx-auto px-4 flex justify-between items-center gap-3">
    <!-- LOGO BRANDING -->
    <a href="/" class="flex items-center gap-2.5 sm:gap-3 group shrink-0">
      <div class="w-9 h-9 sm:w-10 sm:h-10 bg-white rounded-xl p-1 flex items-center justify-center shadow-sm overflow-hidden ring-1 ring-slate-200/30 group-hover:ring-2 group-hover:ring-emerald-400 transition-all duration-200">
        <img
          src="/assets/img/logo.webp"
          alt="Logo InfoProperti"
          width="36"
          height="36"
          class="w-full h-full object-contain"
        />
      </div>
      <div>
        <span class="block text-base sm:text-lg font-extrabold tracking-tight leading-none text-white">
          Info<span class="text-emerald-400">Properti</span>
        </span>
        <span class="block text-[10px] text-slate-400 font-medium mt-0.5">
          infoproperti.web.id
        </span>
      </div>
    </a>

    <!-- DESKTOP NAVBAR -->
    <nav aria-label="Navigasi Utama" class="hidden md:flex items-center gap-1">
      {navLinks.map((item) => (
        <a
          href={item.href}
          aria-current={currentActive === item.key ? 'page' : undefined}
          class={`px-3.5 py-2 rounded-xl text-xs font-semibold transition-all duration-200 ${
            currentActive === item.key
              ? 'bg-emerald-600 text-white shadow-xs shadow-emerald-950/40'
              : 'text-slate-300 hover:text-white hover:bg-slate-800/80'
          }`}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- TOMBOL DAFTAR & MASUK (DESKTOP) + MOBILE MENU BUTTON -->
    <div class="flex items-center gap-2 shrink-0">
      <!-- Guest Actions: Hanya muncul di layar md ke atas -->
      <div id="nav-guest-actions" class="hidden md:flex items-center gap-2">
        <a
          href="/daftar"
          class={`px-3.5 py-2 rounded-xl text-xs font-bold transition whitespace-nowrap ${
            currentActive === 'daftar'
              ? 'bg-white text-slate-900 ring-2 ring-emerald-400'
              : 'bg-slate-800/90 hover:bg-slate-700 text-slate-200 border border-slate-700'
          }`}
        >
          Daftar
        </a>
        <a
          href="/masuk"
          class={`px-3.5 py-2 rounded-xl text-xs font-bold transition whitespace-nowrap ${
            currentActive === 'masuk'
              ? 'bg-emerald-500 text-slate-950 shadow-xs'
              : 'bg-[#059669] hover:bg-emerald-700 text-white'
          }`}
        >
          Masuk
        </a>
      </div>

      <!-- User Actions: Hanya muncul di layar md ke atas saat sudah login -->
      <div id="nav-user-actions" class="hidden items-center gap-2">
        <a
          id="nav-dashboard-link"
          href="/profil"
          class="px-3.5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold transition truncate max-w-[140px]"
        >
          Profil Saya
        </a>
        <button
          type="button"
          id="nav-logout-btn"
          class="px-3 py-2 rounded-xl bg-slate-800 hover:bg-rose-600 text-slate-200 hover:text-white border border-slate-700 text-xs font-bold transition cursor-pointer whitespace-nowrap"
        >
          Keluar
        </button>
      </div>

      <!-- MOBILE MENU BUTTON -->
      <button
        type="button"
        id="mobile-menu-btn"
        aria-label="Buka Menu Navigasi"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="md:hidden p-2.5 rounded-xl bg-slate-800/90 text-slate-200 hover:text-white hover:bg-slate-700 border border-slate-700 cursor-pointer transition"
      >
        <svg id="mobile-icon-open" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="mobile-icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- MOBILE DROPDOWN MENU -->
  <div id="mobile-menu" class="hidden md:hidden px-4 pt-3 pb-4 border-t border-slate-800 mt-3 space-y-1.5">
    {navLinks.map((item) => (
      <a
        href={item.href}
        aria-current={currentActive === item.key ? 'page' : undefined}
        class={`block px-3.5 py-2.5 rounded-xl text-xs font-semibold transition ${
          currentActive === item.key
            ? 'bg-emerald-600 text-white'
            : 'text-slate-300 hover:text-white hover:bg-slate-800'
        }`}
      >
        {item.label}
      </a>
    ))}

    <!-- Tombol Daftar & Masuk di Mobile Menu -->
    <div id="mobile-guest-actions" class="pt-3 mt-2 border-t border-slate-800 grid grid-cols-2 gap-2.5">
      <a
        href="/daftar"
        class={`text-center py-2.5 px-3 rounded-xl text-xs font-bold transition ${
          currentActive === 'daftar'
            ? 'bg-white text-slate-900 ring-2 ring-emerald-400'
            : 'bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700'
        }`}
      >
        Daftar
      </a>
      <a
        href="/masuk"
        class={`text-center py-2.5 px-3 rounded-xl text-xs font-bold transition ${
          currentActive === 'masuk'
            ? 'bg-emerald-500 text-slate-950 shadow-xs'
            : 'bg-[#059669] hover:bg-emerald-700 text-white'
        }`}
      >
        Masuk
      </a>
    </div>

    <!-- Tombol Profil & Keluar di Mobile Menu (Saat Login) -->
    <div id="mobile-user-actions" class="hidden pt-3 mt-2 border-t border-slate-800 items-center gap-2.5">
      <a
        id="mobile-dashboard-link"
        href="/profil"
        class="flex-1 text-center py-2.5 px-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold transition truncate"
      >
        Profil Saya
      </a>
      <button
        type="button"
        id="mobile-logout-btn"
        class="px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-rose-600 text-slate-200 hover:text-white border border-slate-700 text-xs font-bold transition cursor-pointer shrink-0"
      >
        Keluar
      </button>
    </div>
  </div>
</header>

<script is:inline>
  function readAuthSession() {
    try {
      const raw = localStorage.getItem('ip_auth_user');
      if (!raw) return null;
      const parsed = JSON.parse(raw);
      return parsed && typeof parsed === 'object' ? parsed : null;
    } catch {
      return null;
    }
  }

  function initNavbar() {
    const mobileBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('mobile-icon-open');
    const iconClose = document.getElementById('mobile-icon-close');

    const toggleMobileIcons = (isOpen) => {
      if (iconOpen && iconClose) {
        iconOpen.classList.toggle('hidden', isOpen);
        iconClose.classList.toggle('hidden', !isOpen);
      }
    };

    if (mobileBtn && mobileMenu && mobileBtn.dataset.bound !== 'true') {
      mobileBtn.dataset.bound = 'true';
      mobileBtn.addEventListener('click', () => {
        const isHidden = mobileMenu.classList.toggle('hidden');
        const isOpen = !isHidden;
        mobileBtn.setAttribute('aria-expanded', String(isOpen));
        toggleMobileIcons(isOpen);
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !mobileMenu.classList.contains('hidden')) {
          mobileMenu.classList.add('hidden');
          mobileBtn.setAttribute('aria-expanded', 'false');
          toggleMobileIcons(false);
        }
      });
    }

    const guestBox = document.getElementById('nav-guest-actions');
    const userBox = document.getElementById('nav-user-actions');
    const dashLink = document.getElementById('nav-dashboard-link');
    const logoutBtn = document.getElementById('nav-logout-btn');

    const mobileGuestBox = document.getElementById('mobile-guest-actions');
    const mobileUserBox = document.getElementById('mobile-user-actions');
    const mobileDashLink = document.getElementById('mobile-dashboard-link');
    const mobileLogoutBtn = document.getElementById('mobile-logout-btn');

    const session = readAuthSession();

    const handleLogout = () => {
      localStorage.removeItem('ip_auth_user');
      localStorage.removeItem('lapak_agent');
      localStorage.removeItem('lapak_seller');
      window.location.href = '/masuk';
    };

    if (session && (session.role || session.id || session.email)) {
      // Desktop: sembunyikan guest, tampilkan user (hanya di md ke atas)
      guestBox?.classList.remove('md:flex');
      guestBox?.classList.add('hidden');
      userBox?.classList.add('md:flex');

      // Mobile dropdown: sembunyikan guest, tampilkan user
      mobileGuestBox?.classList.add('hidden');
      mobileUserBox?.classList.remove('hidden');
      mobileUserBox?.classList.add('flex');

      const role = String(session.role || 'BUYER').toUpperCase();
      let targetHref = '/profil';
      let targetLabel = session.name || 'Profil Saya';

      if (role === 'SUPER_ADMIN') {
        targetHref = '/superadmin';
        targetLabel = 'Super Admin';
      } else if (role === 'ADMIN' || role === 'SELLER') {
        targetHref = '/admin';
        targetLabel = 'Panel Admin';
      } else if (role === 'AGENT') {
        targetHref = '/agen';
        targetLabel = 'Panel Agen';
      }

      if (dashLink) {
        dashLink.href = targetHref;
        dashLink.textContent = targetLabel;
      }
      if (mobileDashLink) {
        mobileDashLink.href = targetHref;
        mobileDashLink.textContent = targetLabel;
      }

      if (logoutBtn && logoutBtn.dataset.bound !== 'true') {
        logoutBtn.dataset.bound = 'true';
        logoutBtn.addEventListener('click', handleLogout);
      }
      if (mobileLogoutBtn && mobileLogoutBtn.dataset.bound !== 'true') {
        mobileLogoutBtn.dataset.bound = 'true';
        mobileLogoutBtn.addEventListener('click', handleLogout);
      }
    } else {
      // Desktop: tampilkan guest (hanya di md ke atas), sembunyikan user
      guestBox?.classList.add('md:flex');
      userBox?.classList.remove('md:flex');
      userBox?.classList.add('hidden');

      // Mobile dropdown: tampilkan guest, sembunyikan user
      mobileGuestBox?.classList.remove('hidden');
      mobileUserBox?.classList.add('hidden');
      mobileUserBox?.classList.remove('flex');
    }
  }

  initNavbar();
  document.addEventListener('astro:page-load', initNavbar);
</script>