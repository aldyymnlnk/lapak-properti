---
const waConsultUrl = `https://wa.me/6281234567890?text=${encodeURIComponent(
  'Halo Tim LapakProperti, saya ingin konsultasi pencarian atau penawaran unit properti di Malang Raya.'
)}`;
---

<footer class="bg-[#0F172A] text-white pt-14 pb-8 border-t border-slate-800 mt-14">
  <div class="max-w-6xl mx-auto px-4">
    <!-- GRID UTAMA 4 KOLOM -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-8 pb-10 border-b border-slate-800 text-xs">
      
      <!-- KOLOM 1: BRANDING & KONTAK CEPAT (4 KOLOM) -->
      <div class="lg:col-span-4 space-y-3.5">
        <a href="/" class="inline-flex items-center gap-3 group">
          <div class="w-10 h-10 bg-white rounded-xl p-1 flex items-center justify-center shadow-sm overflow-hidden ring-1 ring-slate-200/30 group-hover:ring-2 group-hover:ring-emerald-400 transition-all duration-200">
            <img
              src="/assets/img/logo.webp"
              alt="Logo LapakProperti"
              width="36"
              height="36"
              class="w-full h-full object-contain"
            />
          </div>
          <div>
            <span class="block text-base font-extrabold tracking-tight leading-none text-white">
              Lapak<span class="text-emerald-400">Properti</span>
            </span>
            <span class="block text-[10px] text-slate-400 font-medium mt-0.5">
              Hunian & Kavling Terverifikasi
            </span>
          </div>
        </a>

        <p class="text-slate-400 leading-relaxed">
          Marketplace pencarian Kos, Rumah, dan Kavling Tanah di Malang Raya dengan spesifikasi transparan, status ketersediaan real-time, dan komunikasi langsung via WhatsApp.
        </p>

        <div class="space-y-2 text-slate-300 pt-1">
          <p class="flex items-start gap-2">
            <svg class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>Jl. Soekarno Hatta No. 45, Lowokwaru, Kota Malang</span>
          </p>
          <p class="flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <span>halo@lapakproperti.web.id</span>
          </p>
          <p class="flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span>+62 812-3456-7890 (08.00 – 17.00 WIB)</span>
          </p>
        </div>
      </div>

      <!-- KOLOM 2: MENU NAVIGASI (2 KOLOM) -->
      <div class="lg:col-span-2">
        <h5 class="text-sm font-bold text-white mb-3.5">Menu Utama</h5>
        <ul class="space-y-2.5 text-slate-400">
          <li><a href="/" class="hover:text-emerald-400 transition">Beranda</a></li>
          <li><a href="/tentang" class="hover:text-emerald-400 transition">Tentang Kami</a></li>
          <li><a href="/katalog" class="hover:text-emerald-400 transition">Katalog Properti</a></li>
          <li><a href="/galeri" class="hover:text-emerald-400 transition">Galeri Unit</a></li>
          <!-- href="/blog" otomatis membuka src/pages/blog/index.astro -->
          <li><a href="/blog" class="hover:text-emerald-400 transition">Blog & Panduan</a></li>
          <li><a href="/kontak" class="hover:text-emerald-400 transition">Hubungi Kontak</a></li>
        </ul>
      </div>

      <!-- KOLOM 3: KATEGORI & LAYANAN PEMBELI (3 KOLOM) -->
      <div class="lg:col-span-3">
        <h5 class="text-sm font-bold text-white mb-3.5">Kategori & Panduan</h5>
        <ul class="space-y-2.5 text-slate-400">
          <li><a href="/katalog?category=kos" class="hover:text-emerald-400 transition">Sewa Kos Eksklusif Malang</a></li>
          <li><a href="/katalog?category=rumah" class="hover:text-emerald-400 transition">Rumah Minimalis & Keluarga</a></li>
          <li><a href="/katalog?category=tanah" class="hover:text-emerald-400 transition">Kavling Tanah SHM Siap Bangun</a></li>
          <li><a href="/blog/cek-legalitas-properti" class="hover:text-emerald-400 transition">Panduan Cek Legalitas SHM/HGB</a></li>
          <li><a href="/blog/biaya-jual-beli-rumah" class="hover:text-emerald-400 transition">Simulasi Pajak & Biaya Notaris</a></li>
        </ul>
      </div>

      <!-- KOLOM 4: KONSULTASI WHATSAPP & WILAYAH LAYANAN (3 KOLOM) -->
      <div class="lg:col-span-3 space-y-3.5">
        <h5 class="text-sm font-bold text-white">Konsultasi Langsung</h5>
        <p class="text-slate-400 leading-relaxed">
          Butuh bantuan mencari unit di sekitar kampus atau kawasan hunian Kota Malang & Kota Batu?
        </p>

        <a
          href={waConsultUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 w-full px-4 py-2.5 rounded-xl bg-[#059669] hover:bg-emerald-700 text-white font-bold text-xs transition shadow-sm"
        >
          <span>Chat Konsultan via WhatsApp</span>
        </a>

        <div class="pt-1 flex flex-wrap gap-1.5">
          <span class="px-2.5 py-1 bg-slate-800/90 text-emerald-400 rounded-md border border-slate-700 font-semibold text-[10px]">
            Status Unit Real-Time
          </span>
          <span class="px-2.5 py-1 bg-slate-800/90 text-slate-300 rounded-md border border-slate-700 font-semibold text-[10px]">
            Malang & Batu
          </span>
        </div>
      </div>

    </div>

    <!-- BARIS BAWAH: COPYRIGHT & AKSES PORTAL INTERNAL (AGEN / ADMIN) -->
    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-3">
      <p>© 2026 LapakProperti. Portal Real Estate & Hunian Terverifikasi Malang Raya.</p>
      
      <div class="flex items-center gap-4 text-[11px]">
        <a href="/agen/login" class="text-slate-400 hover:text-emerald-400 transition">Portal Agen</a>
        <span class="text-slate-700">•</span>
        <a href="/admin/login" class="text-slate-400 hover:text-emerald-400 transition">Admin CMS</a>
      </div>
    </div>
  </div>
</footer>