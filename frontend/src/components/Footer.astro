---
const waConsultUrl = `https://wa.me/6281234567890?text=${encodeURIComponent(
  'Halo Tim InfoProperti (infoproperti.web.id), saya ingin konsultasi pencarian atau penawaran unit properti di Malang Raya.'
)}`;

const currentYear = new Date().getFullYear();
---

<footer class="bg-[#0F172A] text-white pt-14 pb-8 border-t border-slate-800/90 mt-16">
  <div class="max-w-6xl mx-auto px-4">
    <!-- GRID UTAMA 4 KOLOM -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-8 pb-12 border-b border-slate-800/90 text-xs">

      <!-- KOLOM 1: BRANDING & KONTAK (4 KOLOM) -->
      <div class="lg:col-span-4 space-y-4">
        <a href="/" class="inline-flex items-center gap-3 group">
          <div class="w-10 h-10 bg-white rounded-xl p-1 flex items-center justify-center shadow-sm overflow-hidden ring-1 ring-slate-200/30 group-hover:ring-2 group-hover:ring-emerald-400 transition-all duration-200">
            <img
              src="/assets/img/logo.webp"
              alt="Logo InfoProperti"
              width="36"
              height="36"
              class="w-full h-full object-contain"
            />
          </div>
          <div>
            <span class="block text-base font-extrabold tracking-tight leading-none text-white">
              Info<span class="text-emerald-400">Properti</span>
            </span>
            <span class="block text-[10px] text-slate-400 font-medium mt-1">
              infoproperti.web.id • Portal Hunian &amp; Kavling
            </span>
          </div>
        </a>

        <p class="text-slate-400 leading-relaxed max-w-sm">
          Platform informasi dan pencarian Kos, Rumah, serta Kavling Tanah di Malang Raya dengan detail unit terstruktur, pembaruan ketersediaan, dan jalur konsultasi langsung ke WhatsApp.
        </p>

        <div class="space-y-2.5 text-slate-300 pt-1">
          <p class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>Lowokwaru, Kota Malang, Jawa Timur</span>
          </p>
          <p class="flex items-center gap-2.5">
            <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href="mailto:halo@infoproperti.web.id" class="hover:text-emerald-400 transition">
              halo@infoproperti.web.id
            </a>
          </p>
          <p class="flex items-center gap-2.5">
            <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>Senin – Sabtu, 08.00 – 17.00 WIB</span>
          </p>
        </div>
      </div>

      <!-- KOLOM 2: NAVIGASI & AKUN (2 KOLOM) -->
      <div class="lg:col-span-2">
        <h5 class="text-xs font-bold uppercase tracking-wider text-slate-200 mb-4">Navigasi</h5>
        <ul class="space-y-2.5 text-slate-400">
          <li><a href="/" class="hover:text-emerald-400 transition">Beranda</a></li>
          <li><a href="/tentang" class="hover:text-emerald-400 transition">Tentang Kami</a></li>
          <li><a href="/katalog" class="hover:text-emerald-400 transition">Katalog Properti</a></li>
          <li><a href="/galeri" class="hover:text-emerald-400 transition">Galeri Unit</a></li>
          <li><a href="/blog" class="hover:text-emerald-400 transition">Blog &amp; Edukasi</a></li>
          <li><a href="/kontak" class="hover:text-emerald-400 transition">Kontak</a></li>
          <li class="pt-1 border-t border-slate-800/80 flex items-center gap-3">
            <a href="/masuk" class="text-slate-300 hover:text-emerald-400 font-semibold transition">Masuk</a>
            <span class="text-slate-600">•</span>
            <a href="/daftar" class="text-emerald-400 hover:text-emerald-300 font-semibold transition">Daftar</a>
          </li>
        </ul>
      </div>

      <!-- KOLOM 3: KATEGORI & LEGAL (3 KOLOM) -->
      <div class="lg:col-span-3">
        <h5 class="text-xs font-bold uppercase tracking-wider text-slate-200 mb-4">Kategori &amp; Legalitas</h5>
        <ul class="space-y-2.5 text-slate-400">
          <li><a href="/katalog?category=kos" class="hover:text-emerald-400 transition">Kos &amp; Hunian Mahasiswa</a></li>
          <li><a href="/katalog?category=rumah" class="hover:text-emerald-400 transition">Rumah Tinggal &amp; Keluarga</a></li>
          <li><a href="/katalog?category=tanah" class="hover:text-emerald-400 transition">Kavling Tanah SHM / HGB</a></li>
          <li class="pt-1 border-t border-slate-800/80">
            <a href="/syarat-ketentuan" class="hover:text-emerald-400 transition">Syarat &amp; Ketentuan</a>
          </li>
          <li>
            <a href="/kebijakan-privasi" class="hover:text-emerald-400 transition">Kebijakan Privasi</a>
          </li>
        </ul>
      </div>

      <!-- KOLOM 4: KONSULTASI & AREA LAYANAN (3 KOLOM) -->
      <div class="lg:col-span-3 space-y-4">
        <h5 class="text-xs font-bold uppercase tracking-wider text-slate-200">Konsultasi Properti</h5>
        <p class="text-slate-400 leading-relaxed">
          Perlu rekomendasi lokasi strategis atau informasi ketersediaan unit di area Malang &amp; Batu? Hubungi tim kami langsung.
        </p>

        <a
          href={waConsultUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 w-full px-4 py-2.5 rounded-xl bg-[#059669] hover:bg-emerald-700 text-white font-bold text-xs transition shadow-sm"
        >
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
          </svg>
          <span>Chat WhatsApp Resmi</span>
        </a>

        <div class="flex flex-wrap gap-1.5">
          <span class="px-2.5 py-1 bg-slate-800/90 text-emerald-400 rounded-lg border border-slate-700/80 font-semibold text-[10px]">
            Kota Malang
          </span>
          <span class="px-2.5 py-1 bg-slate-800/90 text-slate-300 rounded-lg border border-slate-700/80 font-semibold text-[10px]">
            Kab. Malang &amp; Batu
          </span>
        </div>
      </div>

    </div>

    <!-- BARIS BAWAH: COPYRIGHT & TAUTAN LEGAL RINGKAS -->
    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-3">
      <p>&copy; {currentYear} InfoProperti (infoproperti.web.id). Seluruh hak cipta dilindungi.</p>
      <div class="flex items-center gap-4">
        <a href="/syarat-ketentuan" class="hover:text-slate-300 transition">Syarat &amp; Ketentuan</a>
        <a href="/kebijakan-privasi" class="hover:text-slate-300 transition">Kebijakan Privasi</a>
      </div>
    </div>
  </div>
</footer>
